{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@brigade/api", "dev"],
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@brigade/web", "dev"],
      "port": 3000
    },
    {
      "name": "web-workers",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@brigade/web", "exec", "wrangler", "dev", "--port", "8799"],
      "port": 8799
    },
    {
      "name": "api-workers",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@brigade/api",
        "exec",
        "wrangler",
        "dev",
        "--port",
        "8798",
        "--var",
        "RUNNER_BUNDLE_SHA256:local"
      ],
      "port": 8798
    }
  ]
}
