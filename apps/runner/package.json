{
  "name": "@brigade/runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "brigade-runner": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "clean": "rm -rf dist .turbo",
    "spike": "tsx src/harness/spike.ts",
    "bundle": "scripts/bundle.sh"
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.153",
    "@ai-sdk/harness-claude-code": "1.0.157",
    "@ai-sdk/harness-codex": "1.0.155",
    "@brigade/contracts": "workspace:*",
    "@playwright/mcp": "0.0.83",
    "@xterm/headless": "6.0.0",
    "ai": "7.0.142",
    "playwright-core": "1.64.1",
    "pnpm": "10.34.6",
    "smol-toml": "1.9.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15"
  },
  "files": [
    "dist"
  ]
}
