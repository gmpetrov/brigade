{
  "name": "@brigade/runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "brigade-runner": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "clean": "rm -rf dist .turbo",
    "spike": "tsx src/harness/spike.ts",
    "bundle": "scripts/bundle.sh"
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.188",
    "@ai-sdk/harness-acp": "1.0.128",
    "@ai-sdk/harness-claude-code": "1.0.191",
    "@ai-sdk/harness-codex": "1.0.189",
    "@brigade/contracts": "workspace:*",
    "@playwright/mcp": "0.0.86",
    "@xterm/headless": "6.0.0",
    "ai": "7.0.177",
    "modern-screenshot": "4.7.0",
    "playwright-core": "1.65.1",
    "pnpm": "10.34.6",
    "smol-toml": "1.9.1",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/harness-pi": "1.0.191",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "agent-desktop": "1.3.1",
    "tsx": "4.23.15"
  },
  "files": [
    "dist",
    "pi"
  ]
}
