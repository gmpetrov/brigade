{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The API's front door (src/front.ts): it forwards each request to the Api object in
  // brigade-api (wrangler.jsonc). It has a Workers Build of its own: one for brigade-api
  // can only deploy brigade-api.
  "name": "brigade-api-front",
  "main": "src/front.ts",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "api.brigade.lol", "custom_domain": true },
    { "pattern": "designs.brigade.lol", "custom_domain": true },
  ],
  "durable_objects": {
    "bindings": [{ "name": "API", "class_name": "Api", "script_name": "brigade-api" }],
  },
  // For the preflights it answers (src/front.ts): the same as brigade-api's WEB_URL, a
  // secret there. Change both together.
  "vars": { "WEB_URL": "https://www.brigade.lol" },
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
}
