{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The API's front door (src/front.ts): it forwards each request to the Api object in
  // brigade-api (wrangler.jsonc). It has a Workers Build of its own: one for brigade-api
  // can only deploy brigade-api.
  "name": "brigade-api-front",
  "main": "src/front.ts",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "api.brigade.lol", "custom_domain": true },
    { "pattern": "designs.brigade.lol", "custom_domain": true },
  ],
  // brigade-api's objects: the Api object, and each workspace's hub object, to which runners' and
  // dashboards' sockets go (src/front.ts). brigade-api deploys first: scripts/deploy/workers.sh.
  "durable_objects": {
    "bindings": [
      { "name": "API", "class_name": "Api", "script_name": "brigade-api" },
      { "name": "HUBS", "class_name": "WorkspaceHubObject", "script_name": "brigade-api" },
    ],
  },
  // brigade-api's own isolates: the reads of STATELESS_ROUTES run there (src/front.ts).
  "services": [{ "binding": "API_WORKER", "service": "brigade-api" }],
  "vars": {
    // For the preflights it answers (src/front.ts): the same as brigade-api's WEB_URL, a
    // secret there. Change both together.
    "WEB_URL": "https://www.brigade.lol",
    // Paths whose reads run in brigade-api's own isolates rather than the Api object (Phase 4 of
    // docs/workspace-hubs-plan.md), comma-separated; empty: none. Each with a client per request,
    // through Hyperdrive (DB_HYPERDRIVE in wrangler.jsonc): set it only once Hyperdrive is bound.
    // First: "/api/threads,/api/inbox,/api/tasks,/api/projects".
    "STATELESS_ROUTES": "",
    // "hubs": sockets go to their workspace's hub object first (once most workspaces' hubs
    // have one); "api": to the Api object first, which passes on the others (src/front.ts).
    "HUB_ROUTING": "api",
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
}
