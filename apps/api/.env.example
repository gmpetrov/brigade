PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
DATABASE_URL=postgresql://brigade:brigade@localhost:5433/brigade
BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32
BOAT_API_KEY=
VAULT_KEY=generate-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional, Gmail push for "Email received" triggers (otherwise inboxes are checked every minute).
# In the OAuth client's Google Cloud project:
# - Create a Pub/Sub topic and grant gmail-api-push@system.gserviceaccount.com "Pub/Sub Publisher" on it
# - Add a push subscription to {API_URL}/events/gmail with authentication on, as a service
#   account (below), audience {API_URL}/events/gmail
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_PUSH_ACCOUNT=
# The library's bucket (Cloudflare R2, S3 API token). Unset in development: files go to apps/api/.bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Brigade's GitHub App, for GitHub connections (github.com/settings/apps/new):
# - Callback URL: {API_URL}/api/connections/oauth/github/callback
# - Setup URL: {API_URL}/api/connections/oauth/github/setup, with "Redirect on update" on
# - "Request user authorization (OAuth) during installation": off
# - Webhook: on, URL {API_URL}/github/webhook, with a secret (below); subscribe to "Push",
#   and for triggers "Issues", "Issue comment", "Pull request", "Pull request review comment"
# - Repository permissions: Contents, Issues, Pull requests (read and write), Metadata (read)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The .pem with \n escapes, or base64 of the file
GITHUB_APP_PRIVATE_KEY=
# Optional: without it, computers fetch only when a teammate checks a repository out, and
# GitHub triggers are unavailable
GITHUB_APP_WEBHOOK_SECRET=
