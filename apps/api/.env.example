PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
DATABASE_URL=postgresql://brigade:brigade@localhost:5433/brigade
BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32
BOAT_API_KEY=
# Optional, the previews' own site (apps/preview-gateway): its URL and its SECRET.
PREVIEW_GATEWAY_URL=
PREVIEW_GATEWAY_SECRET=
VAULT_KEY=generate-with-openssl-rand-base64-32
# Google sign-in and Gmail/Calendar connections. Authorized redirect URIs on the OAuth client:
# {API_URL}/api/auth/callback/google and {API_URL}/api/connections/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional, Google's MCP servers (e.g. https://bigquery.googleapis.com/mcp). A separate web
# client with "Use this client for an AI-powered agent" on; authorized redirect URI:
# {API_URL}/api/connections/oauth/mcp/callback. Its consent screen needs the servers' scopes.
GOOGLE_MCP_CLIENT_ID=
GOOGLE_MCP_CLIENT_SECRET=
# Optional, Gmail push for "Email received" triggers (otherwise inboxes are checked every minute).
# In the OAuth client's Google Cloud project:
# - Create a Pub/Sub topic and grant gmail-api-push@system.gserviceaccount.com "Pub/Sub Publisher" on it
# - Add a push subscription to {API_URL}/events/gmail with authentication on, as a service
#   account (below), audience {API_URL}/events/gmail
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_PUSH_ACCOUNT=
# The library's bucket (Cloudflare R2, S3 API token). Unset in development: files go to apps/api/.bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Brigade's GitHub App, for GitHub connections (github.com/settings/apps/new):
# - Callback URL: {API_URL}/api/connections/oauth/github/callback
# - Setup URL: {API_URL}/api/connections/oauth/github/setup, with "Redirect on update" on
# - "Request user authorization (OAuth) during installation": off
# - Webhook: on, URL {API_URL}/github/webhook, with a secret (below); subscribe to "Push",
#   and for triggers "Issues", "Issue comment", "Pull request", "Pull request review comment"
# - Repository permissions: Contents, Issues, Pull requests (read and write), Metadata (read)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The .pem with \n escapes, or base64 of the file
GITHUB_APP_PRIVATE_KEY=
# Optional: without it, computers fetch only when a teammate checks a repository out, and
# GitHub triggers are unavailable
GITHUB_APP_WEBHOOK_SECRET=
# The collab server (apps/collab, a Cloudflare Worker) for editing documents together. The same
# secret goes in apps/collab/.dev.vars (wrangler secret put COLLAB_SECRET when deployed). Without
# it, documents are edited without live sync.
COLLAB_URL=http://localhost:8787
COLLAB_SECRET=
# Where designs (pages teammates make) are served from: another host that points at this API,
# ideally on its own domain (e.g. https://brigade-designs.net), so a design's script never runs
# where the dashboard's session is. Defaults to designs.localhost:<port> when API_URL is localhost.
DESIGN_URL=
# Notifications (web push to the dashboard): a key pair from `pnpm --filter @brigade/api vapid`.
# Without it, notifications are off. Keep the pair once set: a new one unsubscribes every device.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who push services may contact: mailto: or https: (default: the dashboard's address, WEB_URL)
VAPID_SUBJECT=
# Billing (docs/billing.md): the Cloud plan, per workspace, gives it the cloud computer. Without
# a key, billing is off and every workspace has the cloud computer. A test key is enough here;
# `pnpm --filter @brigade/api stripe:setup` makes the product, price and portal settings.
STRIPE_SECRET_KEY=
# The webhook to {API_URL}/api/billing/webhook. Optional locally: the billing page then
# reads the subscription from Stripe.
STRIPE_WEBHOOK_SECRET=
