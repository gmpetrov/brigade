// Brigade data model. Every model under Organization carries organizationId,
// and every model under Workspace carries workspaceId (see src/db.ts scoping).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (better-auth core + organization plugin)
// ---------------------------------------------------------------------------

model User {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  authSessions  AuthSession[]
  authAccounts  AuthAccount[]
  members       Member[]
  invitations   Invitation[]
}

/// A signed-in browser session (better-auth "session"). Not a thread.
model AuthSession {
  id                   String   @id
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  activeWorkspaceId    String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
}

/// A sign-in method of a user (better-auth "account"). Not a harness account.
model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

/// Short-lived codes: email verification, and runner link codes.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Organization {
  id          String       @id
  name        String
  slug        String       @unique
  logo        String?
  metadata    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime?    @updatedAt
  members     Member[]
  invitations Invitation[]
  workspaces  Workspace[]
}

/// A user's role in an organization: owner, admin or member.
model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())
  computers      Computer[]
  accounts       Account[]
  sessions       Session[]

  @@unique([organizationId, userId])
  @@index([userId])
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  inviterId      String
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Workspaces, computers and teammates
// ---------------------------------------------------------------------------

model Workspace {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  computers      Computer[]
  runners        Runner[]
  teammates      Teammate[]
  sessions       Session[]
  sessionEvents  SessionEvent[]
  threadSeats    ThreadTeammate[]
  accounts       Account[]
  repositories   Repository[]
  comments       Comment[]
  connections    Connection[]
  vaultSecrets   VaultSecret[]
  credentials    Credential[]
  grants         Grant[]
  connectionCalls ConnectionCall[]
  triggers       Trigger[]
  subscriptions  Subscription[]
  tickets        Ticket[]
  documents      Document[]
  attachments    Attachment[]
  threadAttachments ThreadAttachment[]
  auditEntries   AuditEntry[]

  @@index([organizationId])
}

enum ComputerKind {
  cloud
  member_machine
}

enum ComputerStatus {
  pending
  creating
  starting
  running
  stopped
  error
  destroyed
}

/// The workspace cloud VM, or a member's own machine.
model Computer {
  id             String         @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind           ComputerKind
  /// Set for a member's own machine: only that member runs threads on it.
  memberId       String?
  member         Member?        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name           String
  /// Opaque provider reference for a cloud computer. Only the providers package reads it.
  providerRef    Json?
  size           String?
  status         ComputerStatus @default(pending)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  runner         Runner?
  sessions       Session[]
  accounts       Account[]

  @@index([workspaceId])
}

/// A registered runner process on a computer.
model Runner {
  id              String    @id @default(cuid())
  organizationId  String
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  computerId      String    @unique
  computer        Computer  @relation(fields: [computerId], references: [id], onDelete: Cascade)
  /// SHA-256 of the runner token. The token itself is never stored.
  tokenHash       String    @unique
  version         String?
  protocolVersion Int?
  platform        String?
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([workspaceId])
}

enum Harness {
  claude_code
  codex
}

/// An AI teammate: a saved identity, not a running process.
model Teammate {
  id               String     @id @default(cuid())
  organizationId   String
  workspaceId      String
  workspace        Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name             String
  instructions     String     @default("")
  harness          Harness    @default(claude_code)
  model            String?
  /// { threadsPerDay, computerHoursPerDay, writeCallsPerConnectionPerDay }
  caps             Json       @default("{}")
  /// Per kind of action: allow, ask or deny.
  permissionPolicy Json       @default("{}")
  /// Its grant on the workspace library: read and search it, or also save to it.
  libraryAccess    LibraryAccess @default(read)
  archivedAt       DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  sessions         Session[]
  threadSeats      ThreadTeammate[]
  grants           Grant[]
  triggers         Trigger[]
  connectionCalls  ConnectionCall[]
  documents        Document[]

  @@index([workspaceId])
}

enum LibraryAccess {
  read
  read_write
}

// ---------------------------------------------------------------------------
// Threads
// ---------------------------------------------------------------------------

enum SessionStatus {
  starting
  running
  waiting
  idle
  paused
  failed
  done
}

/// A thread: one conversation with one teammate, one harness session.
enum SessionOrigin {
  member
  trigger
}

model Session {
  id                  String         @id @default(cuid())
  organizationId      String
  workspaceId         String
  workspace           Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  teammateId          String
  teammate            Teammate       @relation(fields: [teammateId], references: [id], onDelete: Cascade)
  startedByMemberId   String
  startedBy           Member         @relation(fields: [startedByMemberId], references: [id], onDelete: Cascade)
  computerId          String
  computer            Computer       @relation(fields: [computerId], references: [id], onDelete: Cascade)
  accountId           String?
  account             Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  title               String
  status              SessionStatus  @default(starting)
  /// A private thread does not write to workspace memory.
  private             Boolean        @default(false)
  /// Lets other members prompt or approve on the starter's subscription.
  othersMayPrompt     Boolean        @default(false)
  /// Set while a member has taken over the thread; the teammate does not act meanwhile.
  controlledByMemberId String?
  /// member: a member's message. trigger: an outside event, whose writes always need approval.
  origin              SessionOrigin  @default(member)
  triggerId           String?
  trigger             Trigger?       @relation(fields: [triggerId], references: [id], onDelete: SetNull)
  /// The trigger's conversation (e.g. a Gmail thread): later events in it continue this thread.
  conversationKey     String?
  /// Highest contiguous event sequence number stored.
  lastSeq             Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  events              SessionEvent[]
  /// Every teammate in the thread, the starting one (teammateId) included.
  teammates           ThreadTeammate[]
  comments            Comment[]
  connectionCalls     ConnectionCall[]
  tickets             Ticket[]
  documents           Document[]
  attachments         ThreadAttachment[]
  /// Files teammates sent from this thread (e.g. attached to an email).
  sentAttachments     Attachment[]

  @@index([workspaceId, createdAt])
  @@index([teammateId])
  @@index([triggerId, conversationKey])
}

/// One AgentEvent with its sequence number. Append-only.
/// A teammate in a thread. A member's mention brings a teammate in; each runs its own
/// harness session on the thread's computer and is told what the others said.
model ThreadTeammate {
  organizationId String
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessionId      String
  session        Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teammateId     String
  teammate       Teammate  @relation(fields: [teammateId], references: [id], onDelete: Cascade)
  joinedAt       DateTime  @default(now())
  /// When it was last asked to answer. A message that mentions no teammate goes to the latest.
  lastTurnAt     DateTime  @default(now())

  @@id([sessionId, teammateId])
  @@index([teammateId])
}

model SessionEvent {
  organizationId String
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessionId      String
  session        Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seq            Int
  type           String
  data           Json
  at             DateTime

  @@id([sessionId, seq])
  @@index([workspaceId, at])
}

// ---------------------------------------------------------------------------
// Harness accounts
// ---------------------------------------------------------------------------

enum AccountStatus {
  signing_in
  unverified
  ready
  needs_sign_in
  exhausted
}

/// machine: the login already on a member's own machine. brigade: signed in
/// through Brigade into its own config directory on the computer.
enum AccountSource {
  machine
  brigade
}

/// One harness login of one member on one computer. Never the credential.
model Account {
  id             String        @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  computerId     String
  computer       Computer      @relation(fields: [computerId], references: [id], onDelete: Cascade)
  provider       Harness
  source         AccountSource @default(machine)
  label          String
  /// Reported by the harness after sign-in. Never the credential.
  email          String?
  plan           String?
  status         AccountStatus @default(unverified)
  /// Out of usage until this time; another account of the member is used meanwhile.
  exhaustedUntil DateTime?
  isDefault      Boolean       @default(false)
  lastUsage      Json?
  lastUsageAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  sessions       Session[]

  @@index([memberId, provider])
}

// ---------------------------------------------------------------------------
// Engineering work
// ---------------------------------------------------------------------------

/// A GitHub repository the workspace works on, and how a teammate gets a checkout ready.
/// Reached through a GitHub connection; this only adds what teammates should do with it.
model Repository {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// owner/name on GitHub, lowercase.
  repository     String
  /// Shell run in a fresh checkout as the teammate, e.g. "pnpm install".
  setupScript    String?
  /// What teammates should know about it, added to their instructions.
  notes          String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, repository])
}

/// A human comment on a diff or a thread.
model Comment {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessionId      String
  session        Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberId       String
  body           String
  filePath       String?
  line           Int?
  createdAt      DateTime  @default(now())

  @@index([sessionId])
}

// ---------------------------------------------------------------------------
// Vault and connectors
// ---------------------------------------------------------------------------

enum ConnectorKind {
  gmail
  google_calendar
  stripe
  github
  /// A custom app that posts events to Brigade. Inbound only: no credential, no operations.
  webhook
}

/// An external account and a reference to its vault secret.
enum ConnectionStatus {
  active
  needs_reauth
  /// Kept so its call log survives; its credential is deleted.
  removed
}

model Connection {
  id                String           @id @default(cuid())
  organizationId    String
  workspaceId       String
  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind              ConnectorKind
  label             String
  /// The external account, e.g. the mailbox address. Never a credential.
  externalAccount   String?
  /// Where a person manages the account at the provider, e.g. a GitHub installation's settings.
  externalUrl       String?
  status            ConnectionStatus @default(active)
  vaultSecretId     String?          @unique
  vaultSecret       VaultSecret?     @relation(fields: [vaultSecretId], references: [id], onDelete: SetNull)
  createdByMemberId String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  grants            Grant[]
  calls             ConnectionCall[]
  triggers          Trigger[]
  subscriptions     Subscription[]
  attachments       Attachment[]

  @@index([workspaceId])
}

/// One encrypted secret. Decrypted only inside the API process.
model VaultSecret {
  id             String      @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ciphertext     Bytes
  iv             Bytes
  authTag        Bytes
  keyVersion     Int         @default(1)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  connection     Connection?
  credential     Credential?

  @@index([workspaceId])
}

enum CredentialKind {
  website
  database
  api_key
  other
}

/// A secret a member keeps for teammates: a website login, a database, an API key.
/// A teammate may use it in a thread where a member mentioned it, or once a person approves.
model Credential {
  id                String         @id @default(cuid())
  organizationId    String
  workspaceId       String
  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind              CredentialKind
  name              String
  /// Non-secret fields: URL, username, host, port, database. Never the secret.
  details           Json           @default("{}")
  vaultSecretId     String         @unique
  vaultSecret       VaultSecret    @relation(fields: [vaultSecretId], references: [id], onDelete: Cascade)
  createdByMemberId String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([workspaceId])
}

enum GrantScope {
  read
  read_write
}

/// Permission for one teammate to use one connection.
model Grant {
  id             String     @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  teammateId     String
  teammate       Teammate   @relation(fields: [teammateId], references: [id], onDelete: Cascade)
  connectionId   String
  connection     Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  scope          GrantScope
  createdAt      DateTime   @default(now())

  @@unique([teammateId, connectionId])
}

/// One connector call. Append-only.
model ConnectionCall {
  id             String     @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessionId      String
  session        Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  connectionId   String
  connection     Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  teammateId     String
  teammate       Teammate   @relation(fields: [teammateId], references: [id], onDelete: Cascade)
  operation      String
  write          Boolean
  target         String
  /// ok, denied, error, or awaiting_approval followed by its outcome in a later row.
  result         String
  error          String?
  /// The approval ticket, when a human decided.
  ticketId       String?
  createdAt      DateTime   @default(now())

  @@index([sessionId])
  @@index([connectionId, createdAt])
  @@index([teammateId, connectionId, createdAt])
}

/// An event on a connection that starts a thread for a teammate, chosen from the
/// connector's catalog (e.g. "stripe.payment_received"), or any event posted to a
/// custom app's URL ("webhook.received").
model Trigger {
  id                   String     @id @default(cuid())
  organizationId       String
  workspaceId          String
  workspace            Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId         String
  connection           Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  teammateId           String
  teammate             Teammate   @relation(fields: [teammateId], references: [id], onDelete: Cascade)
  label                String
  /// The catalog id, e.g. gmail.email_received.
  event                String
  /// The trigger's options from the catalog, e.g. { "query": "to:support@acme.com" }.
  options              Json       @default("{}")
  /// Custom apps only: the unguessable part of the trigger's URL.
  pathToken            String?    @unique
  /// Custom apps only: how the sender is verified.
  verification         TriggerVerification?
  /// Custom apps only: the hmac signing secret, in the vault.
  verificationSecretId String?
  /// Runs on this member's accounts.
  createdByMemberId    String
  createdAt            DateTime   @default(now())
  sessions             Session[]

  @@index([workspaceId])
  @@index([connectionId])
}

enum TriggerVerification {
  /// X-Brigade-Signature: sha256=<hex HMAC of the body>.
  hmac
  /// The URL alone, for apps that sign nothing.
  none
}

/// How Brigade hears about a connection's events: a registration at the vendor
/// (push) or, where the vendor cannot push to this server, a poll. One per
/// connection and resource (the inbox, a calendar, the Stripe account).
model Subscription {
  id             String           @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId   String
  connection     Connection       @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// stripe: "account". gmail: "inbox". google_calendar: the calendar id.
  resource       String
  mode           SubscriptionMode
  /// The vendor's id for it: a Stripe endpoint, a Calendar channel.
  externalId     String?
  /// Calendar: the channel's resource id, needed to stop it.
  externalResourceId String?
  /// The vendor's signing secret or channel token, in the vault.
  secretId       String?
  /// Vendor events it covers (Stripe event types).
  events         String[]
  /// Where reading changes resumes: Gmail's history id, Calendar's sync token.
  cursor         String?
  /// When the vendor drops it unless renewed (Gmail watch, Calendar channel).
  expiresAt      DateTime?
  /// The last failure to subscribe or read, shown on the connection.
  error          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([connectionId, resource])
  @@index([workspaceId])
}

enum SubscriptionMode {
  /// The vendor sends events to Brigade.
  push
  /// Brigade asks every minute: the vendor cannot reach this server.
  poll
}

// ---------------------------------------------------------------------------
// Control and oversight
// ---------------------------------------------------------------------------

enum TicketType {
  approval
  question
  /// A ticket the teammate opened itself (open_ticket): one or more asks.
  request
  sign_in
  cap
  usage_limit
}

enum TicketStatus {
  open
  approved
  denied
  resolved
}

/// Something waiting on a human.
model Ticket {
  id                 String       @id @default(cuid())
  organizationId     String
  workspaceId        String
  workspace          Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessionId          String?
  session            Session?     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type               TicketType
  status             TicketStatus @default(open)
  title              String
  payload            Json         @default("{}")
  resolvedByMemberId String?
  resolvedAt         DateTime?
  createdAt          DateTime     @default(now())

  @@index([workspaceId, status])
  @@index([sessionId])
}

/// Metadata and text-index entry for a library file.
enum DocumentKind {
  library
  workspace_memory
  teammate_memory
  thread_summary
}

/// A library file (its bytes in the bucket, its text here), a memory file or a
/// thread summary (text only). `search` is generated from path and text.
model Document {
  id             String       @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind           DocumentKind @default(library)
  /// Library: the file's path. Memory: workspace.md, teammates/<id>.md or threads/<id>.md.
  path           String
  /// Set for a teammate's memory and a thread summary.
  teammateId     String?
  teammate       Teammate?    @relation(fields: [teammateId], references: [id], onDelete: Cascade)
  /// Set for a thread summary.
  sessionId      String?
  session        Session?     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  contentType    String
  size           Int
  /// SHA-256 of the stored bytes (library) or of the text (memory).
  sha256         String       @default("")
  text           String       @default("")
  /// Whether the text could be read for search.
  indexed        Boolean      @default(false)
  /// Generated by PostgreSQL (see the library_memory migration); never written.
  search         Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('simple'::regconfig, translate(path, '/._-'::text, '    '::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, text), 'B'::\"char\"))"))
  updatedAt      DateTime     @updatedAt
  createdAt      DateTime     @default(now())

  @@unique([workspaceId, kind, path])
  @@index([search], type: Gin)
}

enum ActorType {
  member
  teammate
  runner
  system
}

/// Append-only record of an action. workspaceId is null for organization-level actions.
model AuditEntry {
  id             BigInt     @id @default(autoincrement())
  organizationId String
  workspaceId    String?
  workspace      Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorType      ActorType
  actorId        String
  action         String
  targetType     String
  targetId       String
  data           Json?
  at             DateTime   @default(now())

  @@index([workspaceId, at])
  @@index([organizationId, at])
}

// ---------------------------------------------------------------------------
// Attachments: files given to threads, from a person's computer or a connection
// ---------------------------------------------------------------------------

enum AttachmentSource {
  /// A member uploaded it in the dashboard.
  upload
  /// It came with an event or a call on a connection (an email's attachment).
  connector
  /// A teammate sent it from its working folder (e.g. attached to an email it sends).
  teammate
}

enum AttachmentStatus {
  /// A member's browser is uploading it straight to the bucket; not checked yet.
  pending
  /// The bytes are in the bucket.
  ready
  /// Not stored: too large, a type Brigade does not take from outside, or it could not be fetched.
  blocked
}

/// A file's bytes (in the bucket, keyed by id) and where they came from. One
/// file can be in several threads, e.g. an email two triggers matched.
model Attachment {
  id                 String           @id @default(cuid())
  organizationId     String
  workspaceId        String
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// The file's name, made safe: no folders, no hidden or control characters.
  name               String
  contentType        String
  size               Int
  sha256             String           @default("")
  status             AttachmentStatus @default(ready)
  /// Why it is blocked.
  note               String?
  source             AttachmentSource
  uploadedByMemberId String?
  connectionId       String?
  connection         Connection?      @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  /// The vendor's stable name for it, e.g. gmail:<messageId>:<partId>: fetched once.
  externalRef        String?
  /// Set for a file a teammate sent: the thread it was sent from.
  sessionId          String?
  session            Session?         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// Extracted for search, like a library file's.
  text               String           @default("")
  createdAt          DateTime         @default(now())
  threads            ThreadAttachment[]

  @@unique([connectionId, externalRef])
  @@index([workspaceId, createdAt])
}

/// A file in a thread: copied into each teammate's working folder at `path` before its turn.
model ThreadAttachment {
  id             String     @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessionId      String
  session        Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attachmentId   String
  attachment     Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  /// Relative to a teammate's working folder, e.g. attachments/invoice.pdf. Decided by the API.
  path           String
  createdAt      DateTime   @default(now())

  @@unique([sessionId, path])
  @@unique([sessionId, attachmentId])
  @@index([attachmentId])
}
