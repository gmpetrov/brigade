// Brigade data model. Every model under Organization carries organizationId,
// and every model under Workspace carries workspaceId (see src/db.ts scoping).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// The same client for Cloudflare Workers (src/worker.ts): its query compiler is
// a wasm module, which Node cannot import, so each platform has its own.
generator workers {
  provider = "prisma-client"
  output   = "../src/generated/prisma-workers"
  runtime  = "cloudflare"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (better-auth core + organization plugin)
// ---------------------------------------------------------------------------

model User {
  id              String           @id
  name            String
  email           String           @unique
  emailVerified   Boolean          @default(false)
  image           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  authSessions    AuthSession[]
  authAccounts    AuthAccount[]
  members         Member[]
  invitations     Invitation[]
  pushDevices     PushDevice[]
  /// Where the person came from when they signed up (src/signup-source.ts): set once, never
  /// changed. Utm values, the referrer's host, the first page and the derived channel; no URL.
  attribution     Json?
  analyticsFirsts AnalyticsFirst[]
}

/// The product analytics events a person has sent once already (src/analytics.ts): the next
/// of each carries `first: false`. People who existed before analytics have them all.
model AnalyticsFirst {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event  String
  at     DateTime @default(now())

  @@id([userId, event])
}

/// A workspace's paid plan (src/billing.ts): Cloud, which gives it the cloud computer. It
/// only ever holds Stripe's current state for its subscription. A row with no
/// stripeSubscriptionId and status "active" is a complimentary plan, added by hand.
model BillingSubscription {
  id                   String    @id @default(cuid())
  workspaceId          String
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// "cloud"
  plan                 String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  /// Stripe's: active, trialing, past_due, canceled, unpaid, incomplete…
  status               String    @default("incomplete")
  periodStart          DateTime?
  periodEnd            DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  cancelAt             DateTime?
  canceledAt           DateTime?
  endedAt              DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([workspaceId])
  @@index([stripeSubscriptionId])
}

/// A signed-in browser session (better-auth "session"). Not a thread.
model AuthSession {
  id                   String   @id
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  activeWorkspaceId    String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
}

/// A sign-in method of a user (better-auth "account"). Not a harness account.
model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

/// Short-lived codes: email verification, and runner link codes.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// better-auth's rate limit (src/auth.ts): requests to sign in and to mail a code, per visitor and path.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Organization {
  id              String           @id
  name            String
  slug            String           @unique
  logo            String?
  metadata        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime?        @updatedAt
  members         Member[]
  invitations     Invitation[]
  workspaces      Workspace[]
  billingClosings BillingClosing[]
}

/// A deletion of the organization under way (src/billing.ts): while one is younger than 10
/// minutes, no Checkout starts in it. One per request, so each removes only its own when it
/// is refused or fails; the deletion itself removes them all.
model BillingClosing {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Set when only this workspace is being deleted (src/workspace-delete.ts): the others of the
  /// organization may still start a Checkout. No link: it outlives the workspace a moment.
  workspaceId    String?
  createdAt      DateTime

  @@index([organizationId])
}

/// A user's role in an organization: owner, admin or member.
model Member {
  id                    String                 @id
  organizationId        String
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                  String                 @default("member")
  createdAt             DateTime               @default(now())
  computers             Computer[]
  accounts              Account[]
  sessions              Session[]
  tasks                 Task[]
  schedules             Schedule[]
  threadReads           ThreadRead[]
  threadPins            ThreadPin[]
  documentPins          DocumentPin[]
  sidebarOrders         SidebarOrder[]
  threadLaters          ThreadLater[]
  homeDismissals        HomeDismissal[]
  /// Which notifications reach their devices (src/notifications.ts).
  notify                NotifyPreset           @default(needed)
  /// Their message box suggests what they may write next, guessed after each turn on their account.
  suggestions           Boolean                @default(true)
  pushNotices           PushNotice[]
  /// Playbooks that run on their accounts.
  playbookInstallations PlaybookInstallation[]

  @@unique([organizationId, userId])
  @@index([userId])
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  inviterId      String
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Workspaces, computers and teammates
// ---------------------------------------------------------------------------

/// Where a workspace's hub runs on Cloudflare (Workspace.hubMode).
enum HubMode {
  api
  object
}

model Workspace {
  id                    String                 @id @default(cuid())
  organizationId        String
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                  String
  /// Its logo in the bucket (workspaceLogoKey), shown instead of its letter: "<version>.<type>",
  /// e.g. "k2x9f1.png". Unset: none.
  logo                  String?
  /// Its own Stripe customer (src/billing.ts), made on its first Checkout: its plan's
  /// invoices and card, apart from any other workspace's.
  stripeCustomerId      String?
  /// Where its hub runs on Cloudflare (docs/workspace-hubs-plan.md): in the Api object with
  /// every other workspace's, or in a Durable Object of its own. Changed with POST /ops/hubs.
  hubMode               HubMode                @default(api)
  /// Set while it is being deleted (src/deletion-fence.ts): no new thread, turn or cloud computer
  /// starts. Cleared when the deletion is refused or fails; older than its lease, it holds no more.
  deletingAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  computers             Computer[]
  runners               Runner[]
  teammates             Teammate[]
  sessions              Session[]
  sessionEvents         SessionEvent[]
  tokenUsage            TokenUsage[]
  threadSeats           ThreadTeammate[]
  accounts              Account[]
  comments              Comment[]
  connections           Connection[]
  apps                  App[]
  vaultSecrets          VaultSecret[]
  credentials           Credential[]
  credentialGrants      CredentialGrant[]
  grants                Grant[]
  connectionCalls       ConnectionCall[]
  triggers              Trigger[]
  subscriptions         Subscription[]
  tickets               Ticket[]
  documents             Document[]
  libraryFolders        LibraryFolder[]
  libraryFolderGrants   LibraryFolderGrant[]
  attachments           Attachment[]
  threadAttachments     ThreadAttachment[]
  pullRequests          PullRequest[]
  pullRequestReviews    PullRequestReview[]
  tasks                 Task[]
  schedules             Schedule[]
  wakeups               Wakeup[]
  replyWatches          ReplyWatch[]
  heldCalls             HeldCall[]
  runnerCommands        RunnerCommand[]
  specParts             SpecPart[]
  triggerDeliveries     TriggerDelivery[]
  projects              Project[]
  projectRepositories   ProjectRepository[]
  auditEntries          AuditEntry[]
  designSystems         DesignSystem[]
  skills                Skill[]
  skillPacks            SkillPack[]
  previewRecipes        PreviewRecipe[]
  previewVariables      PreviewVariable[]
  threadReads           ThreadRead[]
  threadPins            ThreadPin[]
  documentPins          DocumentPin[]
  sidebarOrders         SidebarOrder[]
  threadLaters          ThreadLater[]
  homeDismissals        HomeDismissal[]
  pushNotices           PushNotice[]
  playbookInstallations PlaybookInstallation[]
  playbookActions       PlaybookAction[]
  playbookRuns          PlaybookRun[]
  playbookDryRuns       PlaybookDryRun[]
  threadFollows         ThreadFollow[]
  billingSubscriptions  BillingSubscription[]
  mailProjects          MailProject[]
  mailAliases           MailAlias[]
  mailMessages          MailMessage[]
  mailDomains           MailDomain[]
  contacts              Contact[]
  contactHandles        ContactHandle[]

  listItems       ListItem[]
  listItemThreads ListItemThread[]
  listItemPulls   ListItemPull[]

  @@index([organizationId])
}

enum ComputerKind {
  cloud
  member_machine
}

enum ComputerStatus {
  pending
  creating
  starting
  running
  stopped
  error
  destroyed
}

/// The workspace cloud VM, or a member's own machine.
model Computer {
  id             String                @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind           ComputerKind
  /// Set for a member's own machine: only that member runs threads on it.
  memberId       String?
  member         Member?               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name           String
  /// Opaque provider reference for a cloud computer. Only the providers package reads it.
  providerRef    Json?
  size           String?
  /// A member's machine: its OS machine ID and runner home, hashed by the runner. Linking
  /// again from the same place keeps this computer.
  machineId      String?
  status         ComputerStatus        @default(pending)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  runner         Runner?
  sessions       Session[]
  accounts       Account[]
  commands       RunnerCommand[]
  replacements   ComputerReplacement[]

  @@index([workspaceId])
  @@index([workspaceId, memberId, machineId])
}

/// A registered runner process on a computer.
model Runner {
  id              String    @id @default(cuid())
  organizationId  String
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  computerId      String    @unique
  computer        Computer  @relation(fields: [computerId], references: [id], onDelete: Cascade)
  /// SHA-256 of the runner token. The token itself is never stored.
  tokenHash       String    @unique
  version         String?
  protocolVersion Int?
  platform        String?
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([workspaceId])
}

enum Harness {
  claude_code
  codex
}

/// chief: the teammate every workspace has one of. It sets up the team and routes work.
enum TeammateKind {
  teammate
  chief
}

/// An AI teammate: a saved identity, not a running process.
model Teammate {
  id                    String                 @id @default(cuid())
  organizationId        String
  workspaceId           String
  workspace             Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                  String
  /// Free text shown as a badge beside its name, e.g. "Software engineer".
  title                 String                 @default("")
  kind                  TeammateKind           @default(teammate)
  instructions          String                 @default("")
  harness               Harness                @default(claude_code)
  model                 String?
  /// { threadsPerDay, computerHoursPerDay, writeCallsPerConnectionPerDay }
  caps                  Json                   @default("{}")
  /// Per kind of action: allow, ask or deny.
  permissionPolicy      Json                   @default("{}")
  /// Its grant on the workspace library: read and search it, or also save to it.
  libraryAccess         LibraryAccess          @default(read)
  archivedAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  sessions              Session[]
  threadSeats           ThreadTeammate[]
  grants                Grant[]
  credentialGrants      CredentialGrant[]
  savedCredentials      Credential[]
  triggers              Trigger[]
  connectionCalls       ConnectionCall[]
  documents             Document[]
  libraryFolderGrants   LibraryFolderGrant[]
  pullRequestsAuthored  PullRequest[]          @relation("PullRequestAuthor")
  pullRequestReviews    PullRequestReview[]
  tasks                 Task[]
  tasksCreated          Task[]                 @relation("TaskCreatedByTeammate")
  schedules             Schedule[]
  schedulesCreated      Schedule[]             @relation("ScheduleCreatedByTeammate")
  wakeups               Wakeup[]
  replyWatches          ReplyWatch[]
  playbookInstallations PlaybookInstallation[]
  backups               TeammateBackup[]

  @@index([workspaceId])
}

enum LibraryAccess {
  read
  read_write
}

// ---------------------------------------------------------------------------
// Threads
// ---------------------------------------------------------------------------

enum SessionStatus {
  starting
  running
  waiting
  idle
  paused
  failed
  done
}

/// When a member last looked at a thread: a teammate's reply after it is unread for them.
model ThreadRead {
  organizationId String
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sessionId      String
  session        Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seenAt         DateTime  @default(now())

  @@id([memberId, sessionId])
  @@index([sessionId])
}

/// A thread a member pinned: it stays at the top of their sidebar, under Pinned.
model ThreadPin {
  organizationId String
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sessionId      String
  session        Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  pinnedAt       DateTime  @default(now())
  /// Where it sits under Pinned, as the member dragged it: lowest first, then by pinnedAt.
  position       Int       @default(0)

  @@id([memberId, sessionId])
  @@index([sessionId])
}

/// The order a member dragged a list of their sidebar to (its teammates or its projects), in a
/// workspace: the ids, first to last. Those not in it follow, in the list's own order.
model SidebarOrder {
  organizationId String
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// "teammates" or "projects".
  list           String
  ids            String[]
  updatedAt      DateTime  @updatedAt

  @@id([memberId, workspaceId, list])
  @@index([workspaceId])
}

/// A thread a member put away for later: out of their sidebar's list and of what waits on
/// them, under the filter's Later. Each member's own, like a pin. Anything new in the thread
/// after laterAt (a message, a turn, a ticket, a pull request) brings it back (src/later.ts).
model ThreadLater {
  organizationId String
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sessionId      String
  session        Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  laterAt        DateTime  @default(now())

  @@id([memberId, sessionId])
  @@index([sessionId])
  @@index([workspaceId])
}

/// A loose end a member set aside on Home. Its key names the thing as it stood then (a thread's
/// proposal by its event, a stalled thread by its last event, a routine by its failed run), so
/// the same thing comes back once it changes.
model HomeDismissal {
  organizationId String
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  key            String
  dismissedAt    DateTime  @default(now())

  @@id([memberId, key])
}

/// A thread: one conversation with one teammate, one harness session.
enum SessionOrigin {
  member
  trigger
  schedule
  child
}

model Session {
  id                   String             @id @default(cuid())
  organizationId       String
  workspaceId          String
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  teammateId           String
  teammate             Teammate           @relation(fields: [teammateId], references: [id], onDelete: Cascade)
  startedByMemberId    String
  startedBy            Member             @relation(fields: [startedByMemberId], references: [id], onDelete: Cascade)
  computerId           String
  computer             Computer           @relation(fields: [computerId], references: [id], onDelete: Cascade)
  accountId            String?
  account              Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  title                String
  status               SessionStatus      @default(starting)
  /// A private thread does not write to workspace memory.
  private              Boolean            @default(false)
  /// Lets other members prompt or approve on the starter's subscription.
  othersMayPrompt      Boolean            @default(false)
  /// Set while a member has taken over the thread; the teammate does not act meanwhile.
  controlledByMemberId String?
  /// member: a member's message. trigger: an outside event. schedule: a schedule's instructions, at its time.
  /// child: a teammate started it from its parent thread (start_child).
  origin               SessionOrigin      @default(member)
  /// The thread it was started from (start_child, or a schedule's run that reports there): out of the
  /// sidebar, shown in its parent, which its report wakes (src/children.ts). One level only.
  parentId             String?
  parent               Session?           @relation("SessionChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children             Session[]          @relation("SessionChildren")
  /// The parent's teammate that started it, the one its report wakes.
  parentTeammateId     String?
  /// Its parent waits for its report, with the others it waits for; false for a schedule's run.
  awaited              Boolean            @default(false)
  /// Past this, an awaited child no longer holds its parent back: the parent is told what is done.
  awaitUntil           DateTime?
  /// Its report, once its turn ended: { status: nothing | report | needs_person | failed | cancelled, summary, at }.
  report               Json?
  /// When its report reached the parent (or was settled without waking it). A new turn clears both.
  reportDeliveredAt    DateTime?
  /// A turn that answered a person ended without a report: its last message goes to the parent at
  /// this time, unless the person writes again first (REPORT_AFTER_PERSON_MINUTES).
  reportDueAt          DateTime?
  triggerId            String?
  trigger              Trigger?           @relation(fields: [triggerId], references: [id], onDelete: SetNull)
  /// The trigger's conversation (e.g. a Gmail thread): later events in it continue this thread.
  conversationKey      String?
  scheduleId           String?
  schedule             Schedule?          @relation("ScheduleRuns", fields: [scheduleId], references: [id], onDelete: SetNull)
  /// Set while archived: out of the sidebar for everyone. A new message brings it back.
  archivedAt           DateTime?
  /// Highest contiguous event sequence number stored.
  lastSeq              Int                @default(0)
  /// While it moves to another computer: where to, how far it got and the message that goes with it (src/move.ts).
  move                 Json?
  /// When it last came to its computer from another, from which (by name), and its last event then (ThreadSpec.moved).
  movedAt              DateTime?
  movedFrom            String?
  movedSeq             Int?
  /// How hard its teammates think (ThreadSpec.effort): low, medium, high, xhigh or max. Null: the harness's default.
  effort               String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  events               SessionEvent[]
  tokenUsage           TokenUsage[]
  /// Every teammate in the thread, the starting one (teammateId) included.
  teammates            ThreadTeammate[]
  comments             Comment[]
  connectionCalls      ConnectionCall[]
  tickets              Ticket[]
  documents            Document[]
  attachments          ThreadAttachment[]
  /// Files teammates sent from this thread (e.g. attached to an email).
  sentAttachments      Attachment[]
  /// Pull requests opened from this thread; their reviews report here.
  pullRequests         PullRequest[]      @relation("PullRequestThread")
  /// The pull requests this thread reviews (src/reviews.ts).
  reviewsOf            PullRequest[]      @relation("PullRequestReviewThread")
  /// When each member last looked at it.
  reads                ThreadRead[]
  /// The members who pinned it.
  pins                 ThreadPin[]
  /// The members who put it away for later.
  laters               ThreadLater[]
  /// The task this thread works on. One thread per task for now.
  taskId               String?            @unique
  task                 Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  /// The project the thread works in: its brief, memory, folder and repositories come with each turn.
  projectId            String?
  project              Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Times a teammate set to be prompted here again.
  wakeups              Wakeup[]
  replyWatches         ReplyWatch[]
  /// Calls waiting on a person's decision, and commands on their way to its computer.
  heldCalls            HeldCall[]
  runnerCommands       RunnerCommand[]
  /// Schedules whose runs report here, as its children.
  reportingSchedules   Schedule[]         @relation("ScheduleParent")
  /// The playbook run it belongs to: its root thread and the root's children (src/playbooks.ts).
  playbookRunId        String?
  playbookRun          PlaybookRun?       @relation("PlaybookRunThreads", fields: [playbookRunId], references: [id], onDelete: SetNull)
  /// In a playbook's run: the teammate setting this thread works as (a fix handed to its
  /// developer), whose Apps alone it has. Null: the one its runs start with.
  playbookTeammate     String?
  /// The run it is the root thread of.
  rootOfPlaybookRun    PlaybookRun?       @relation("PlaybookRunRoot")
  /// A run's thread stays out of the sidebar's Threads until a person first takes part in it
  /// (a message, a takeover, a pin): then this is set, and it stays there.
  surfacedAt           DateTime?
  /// Started by a rule on a mailbox (an email trigger): out of the sidebar's Threads, like a
  /// playbook's run, until a person takes part in it or it needs one (surfacedAt).
  quiet                Boolean            @default(false)
  /// Emails it received or sent through Brigade's own addresses (the Email App).
  mailMessages         MailMessage[]
  /// Sign-up addresses it asked for (email_new_address).
  mailAliases          MailAlias[]
  /// The dry runs of a playbook started from this thread (its installation's chat).
  playbookDryRuns      PlaybookDryRun[]
  /// Threads it follows (follow_thread): their report wakes it, like a parent's child's.
  following            ThreadFollow[]     @relation("ThreadFollower")
  /// Threads that follow it.
  followers            ThreadFollow[]     @relation("ThreadFollowed")
  folderBackups        FolderBackup[]

  /// The list items it works on (docs/lists.md).
  listItems ListItemThread[]

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
  @@index([teammateId])
  @@index([triggerId, conversationKey])
  @@index([scheduleId, createdAt])
  @@index([parentId, createdAt])
  @@index([reportDueAt])
  @@index([playbookRunId])
}

/// One AgentEvent with its sequence number. Append-only.
/// A teammate in a thread. A member's mention brings a teammate in; each runs its own
/// harness session on the thread's computer and is told what the others said.
enum TaskPriority {
  low
  medium
  high
  urgent
}

/// Work to see finished, on the Tasks board. Its thread is its comments and
/// progress; the column comes from the thread (none: backlog) and completedAt.
/// Assigning a teammate starts the thread, so a task has a teammate once it has one.
model Task {
  id                  String       @id @default(cuid())
  organizationId      String
  workspaceId         String
  workspace           Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title               String
  description         String       @default("")
  priority            TaskPriority @default(medium)
  /// The teammate doing it. Unset in the backlog: nobody is on it yet.
  teammateId          String?
  teammate            Teammate?    @relation(fields: [teammateId], references: [id], onDelete: SetNull)
  /// Who asked: the member, or the thread's starter when a teammate created it.
  createdByMemberId   String
  createdBy           Member       @relation(fields: [createdByMemberId], references: [id], onDelete: Cascade)
  /// Set when a teammate created it, with its task tools.
  createdByTeammateId String?
  createdByTeammate   Teammate?    @relation("TaskCreatedByTeammate", fields: [createdByTeammateId], references: [id], onDelete: SetNull)
  /// What was done, from whoever marked it done.
  summary             String?
  /// Links to what it produced: [{ label, url }].
  deliverables        Json         @default("[]")
  completedAt         DateTime?
  /// Off the board: a done task put away. Reopening it brings it back.
  archivedAt          DateTime?
  /// In the Trash: off the board, from any column. Restoring it brings it back.
  trashedAt           DateTime?
  /// The project it belongs to; its thread starts there.
  projectId           String?
  project             Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Its mission: a task whose sub-tasks it groups on the board ("Mission" in visible text
  /// only). One level: a sub-task has no sub-tasks. Deleting the mission leaves them as tasks.
  parentId            String?
  parent              Task?        @relation("TaskChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children            Task[]       @relation("TaskChildren")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  session             Session?

  @@index([workspaceId, completedAt])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, trashedAt])
  @@index([teammateId])
  @@index([projectId])
  @@index([parentId])
}

/// A teammate prompted with the same instructions on a cron schedule; each
/// firing starts a fresh thread on the owner's accounts.
model Schedule {
  id                     String                @id @default(cuid())
  organizationId         String
  workspaceId            String
  workspace              Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  teammateId             String
  teammate               Teammate              @relation(fields: [teammateId], references: [id], onDelete: Cascade)
  title                  String
  /// The first message of each run.
  instructions           String
  /// Five fields: minute, hour, day of month, month, day of week.
  cron                   String
  /// IANA, e.g. Europe/Paris: the cron's hours are in this zone.
  timezone               String
  /// Runs on this member's accounts; only they edit it.
  ownerMemberId          String
  owner                  Member                @relation(fields: [ownerMemberId], references: [id], onDelete: Cascade)
  /// Set when a teammate created it from a thread.
  createdByTeammateId    String?
  createdByTeammate      Teammate?             @relation("ScheduleCreatedByTeammate", fields: [createdByTeammateId], references: [id], onDelete: SetNull)
  pausedAt               DateTime?
  /// The next firing; null while paused.
  nextRunAt              DateTime?
  /// Why the last firing could not start; cleared by the next one that does.
  lastError              String?
  /// Its runs start in this project. Reporting to a thread, it is that thread's project, kept in step when the thread moves.
  projectId              String?
  project                Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Set when made from a thread to report there: each run is a child of that thread (src/children.ts).
  parentSessionId        String?
  parentSession          Session?              @relation("ScheduleParent", fields: [parentSessionId], references: [id], onDelete: SetNull)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  sessions               Session[]             @relation("ScheduleRuns")
  /// Set when a playbook made it: changed only through the playbook, deleted with it.
  playbookInstallationId String?
  playbookInstallation   PlaybookInstallation? @relation(fields: [playbookInstallationId], references: [id], onDelete: Cascade)

  @@index([nextRunAt])
  @@index([workspaceId])
  @@index([teammateId])
}

/// wakeup: a teammate's own (set_wakeup). report: its children's reports, brought back to it (src/children.ts).
enum WakeupKind {
  wakeup
  report
  /// A reply in an email conversation the thread waits on (ReplyWatch); its note is the email.
  reply
}

enum WakeupStatus {
  pending
  fired
  cancelled
  /// Its computer stayed offline too long after it was due.
  missed
}

/// A teammate asked to be prompted again in its thread at a time ("check CI in 10 minutes").
/// The API's minute tick fires it into the same thread, with the conversation so far.
model Wakeup {
  id             String       @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessionId      String
  session        Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teammateId     String
  teammate       Teammate     @relation(fields: [teammateId], references: [id], onDelete: Cascade)
  /// What to check, in the teammate's words: the prompt it gets back. For a report, the prompt itself.
  note           String
  kind           WakeupKind   @default(wakeup)
  wakeAt         DateTime
  status         WakeupStatus @default(pending)
  firedAt        DateTime?
  createdAt      DateTime     @default(now())
  /// What brought it, for a reply: the email's id (gmail:<message id>), so reading it again wakes nobody twice.
  sourceId       String?

  @@unique([sessionId, sourceId])
  @@index([status, wakeAt])
  @@index([sessionId, status])
}

/// An email a teammate sent from a thread: a reply in its conversation wakes that thread, until
/// `until`. Another email in the conversation moves `until` on; cancelling sets it to now.
model ReplyWatch {
  id              String     @id @default(cuid())
  organizationId  String
  workspaceId     String
  workspace       Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessionId       String
  session         Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// The teammate that sent it, the one woken.
  teammateId      String
  teammate        Teammate   @relation(fields: [teammateId], references: [id], onDelete: Cascade)
  connectionId    String
  connection      Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// The provider's conversation: a Gmail thread id.
  conversationKey String
  /// Who the last email went to and its subject, as sent, for the thread's panel.
  to              String
  subject         String
  until           DateTime
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([sessionId, connectionId, conversationKey])
  @@index([connectionId, conversationKey])
  @@index([workspaceId])
}

model ThreadTeammate {
  organizationId String
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessionId      String
  session        Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teammateId     String
  teammate       Teammate  @relation(fields: [teammateId], references: [id], onDelete: Cascade)
  joinedAt       DateTime  @default(now())
  /// When it was last asked to answer. A message that mentions no teammate goes to the latest.
  lastTurnAt     DateTime  @default(now())

  @@id([sessionId, teammateId])
  @@index([teammateId])
}

model SessionEvent {
  organizationId String
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessionId      String
  session        Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seq            Int
  type           String
  data           Json
  at             DateTime

  @@id([sessionId, seq])
  @@index([workspaceId, at])
  /// Thread lists count each thread's messages and answers by type.
  @@index([sessionId, type])
}

/// What a harness spent for the workspace, in tokens: one row per stream of a teammate's turn
/// (its usage.updated event, by seq) and per run outside a turn (memory, title, a project's
/// brief, an image). Counts only, never what was said (src/usage.ts, Settings › Usage).
/// Who and what it was for are copied in when it is stored: a thread deleted later keeps
/// its tokens in the totals.
model TokenUsage {
  id               String    @id @default(cuid())
  organizationId   String
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessionId        String?
  session          Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  /// The thread's usage.updated event it was stored from; null for a run outside a turn.
  seq              Int?
  teammateId       String?
  /// The account that spent it, and the member it belongs to.
  accountId        String?
  memberId         String?
  projectId        String?
  /// The routine whose run it was.
  scheduleId       String?
  provider         Harness
  /// As the harness named it; null when it did not say.
  model            String?
  /// What asked for it (UsageSource): member, trigger, schedule, child, review, playbook,
  /// or a run outside a turn: memory, tidy, title, brief, image.
  source           String
  /// All input, the cache's reads and writes included.
  inputTokens      Int       @default(0)
  cacheReadTokens  Int       @default(0)
  cacheWriteTokens Int       @default(0)
  outputTokens     Int       @default(0)
  reasoningTokens  Int       @default(0)
  at               DateTime
  createdAt        DateTime  @default(now())

  @@unique([sessionId, seq])
  @@index([workspaceId, at])
}

// ---------------------------------------------------------------------------
// Harness accounts
// ---------------------------------------------------------------------------

enum AccountStatus {
  signing_in
  unverified
  ready
  needs_sign_in
  exhausted
}

/// machine: the login already on a member's own machine. brigade: signed in
/// through Brigade into its own config directory on the computer.
enum AccountSource {
  machine
  brigade
}

/// One harness login of one member on one computer. Never the credential.
model Account {
  id             String              @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  computerId     String
  computer       Computer            @relation(fields: [computerId], references: [id], onDelete: Cascade)
  provider       Harness
  source         AccountSource       @default(machine)
  label          String
  /// Reported by the harness after sign-in. Never the credential.
  email          String?
  plan           String?
  status         AccountStatus       @default(unverified)
  /// Out of usage until this time; another account of the member is used meanwhile.
  exhaustedUntil DateTime?
  isDefault      Boolean             @default(false)
  lastUsage      Json?
  lastUsageAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  sessions       Session[]
  loginBackup    AccountLoginBackup?

  @@index([memberId, provider])
}

// ---------------------------------------------------------------------------
// Engineering work
// ---------------------------------------------------------------------------

/// Where a merge a person asked for stands. GitHub keeps the pull request's code and state.
/// In the database it keeps the review loop's type and column names (ReviewStatus,
/// reviewStatus): renaming them would break the API running while the next one starts.
enum MergeStatus {
  /// No merge under way.
  none
  /// It stopped and a person has a ticket: the conflicts were not resolved, or GitHub refuses the merge.
  stuck
  /// A person asked to merge it once its conflicts are resolved: the author teammate's turn.
  resolving
  /// A person asked to merge it: it merges once GitHub allows it, with mergeMethod.
  merging

  @@map("ReviewStatus")
}

/// Whether a project's pull requests get a review by another teammate (src/reviews.ts).
enum ReviewPolicy {
  /// The teammate that opens one says whether it gets a review, and why.
  teammate
  /// Only when someone asks: on the pull request's page, or in its thread.
  manual
}

/// A pull request Brigade knows about: opened by a teammate, or put through a review.
model PullRequest {
  id                  String              @id @default(cuid())
  organizationId      String
  workspaceId         String
  workspace           Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// owner/name on GitHub, lowercase.
  repository          String
  number              Int
  title               String
  headRef             String
  baseRef             String
  /// The thread that opened it (or its review's own thread, for one opened outside Brigade).
  sessionId           String?
  session             Session?            @relation("PullRequestThread", fields: [sessionId], references: [id], onDelete: SetNull)
  authorTeammateId    String?
  authorTeammate      Teammate?           @relation("PullRequestAuthor", fields: [authorTeammateId], references: [id], onDelete: SetNull)
  /// Its latest review's thread: a child of the thread that opened it, or a thread of its own.
  reviewSessionId     String?
  reviewSession       Session?            @relation("PullRequestReviewThread", fields: [reviewSessionId], references: [id], onDelete: SetNull)
  /// Why the teammate that opened it asked for no review, in its words: shown on it.
  noReviewReason      String?
  /// While a review of it is being started: one at a time (src/reviews.ts).
  reviewClaimedAt     DateTime?
  mergeStatus         MergeStatus         @default(none) @map("reviewStatus")
  /// How it merges when Brigade merges it; squash when unset.
  mergeMethod         String?
  /// The member who last asked to merge it or for its review: its tickets and pushes go to them.
  requestedByMemberId String?
  /// The author's turns at resolving its conflicts and getting it merged, from 1.
  round               Int                 @default(0)
  /// The head when the author's turn to resolve the conflicts began: unchanged after it, nothing was pushed.
  resolveFromSha      String?             @map("reviewedSha")
  /// Why a merge is waiting or stopped, shown on the pull request.
  note                String?
  /// As last seen on GitHub: open, closed or merged.
  state               String              @default("open")
  mergedAt            DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  reviews             PullRequestReview[]

  /// The list items it works on, or finishes (docs/lists.md).
  listItems ListItemPull[]

  @@unique([workspaceId, repository, number])
  @@index([sessionId])
  @@index([reviewSessionId])
  @@index([mergeStatus])
}

enum ReviewVerdict {
  approve
  request_changes
}

/// A teammate's review, from github_review_pull_request.
model PullRequestReview {
  id             String        @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pullRequestId  String
  pullRequest    PullRequest   @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  teammateId     String?
  teammate       Teammate?     @relation(fields: [teammateId], references: [id], onDelete: SetNull)
  sessionId      String?
  verdict        ReviewVerdict
  body           String
  /// Line comments: [{ path, line, body }].
  comments       Json          @default("[]")
  /// The head commit it reviewed.
  sha            String
  /// Its place among the pull request's reviews, from 1.
  round          Int
  url            String?
  createdAt      DateTime      @default(now())

  @@index([pullRequestId, createdAt])
}

/// A human comment on a diff or a thread.
model Comment {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessionId      String
  session        Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberId       String
  body           String
  filePath       String?
  line           Int?
  createdAt      DateTime  @default(now())

  @@index([sessionId])
}

// ---------------------------------------------------------------------------
// Vault and connectors
// ---------------------------------------------------------------------------

enum ConnectorKind {
  gmail
  google_calendar
  /// Google Drive, Docs and Sheets: three Apps on Google's APIs, signed in like Gmail.
  google_drive
  google_docs
  google_sheets
  stripe
  github
  /// A custom app that posts events to Brigade. Inbound only: no credential, no operations.
  webhook
  /// Cloudflare's MCP server: its tools come from the server, through the API.
  cloudflare
  /// Google Cloud, through Google's Cloud CLI MCP server and Brigade's own Google client.
  google_cloud
  /// Neon, through Neon's MCP server and its own OAuth.
  neon
  /// Supabase, through Supabase's MCP server and its own OAuth.
  supabase
  /// Atlassian (Jira and Confluence), through Atlassian's Rovo MCP server.
  atlassian
  /// Notion's MCP server: its tools come from the server, through the API.
  notion
  /// Linear, through Linear's own MCP server and its OAuth.
  linear
  /// Mixpanel, through Mixpanel's own MCP server (one per data region) and its OAuth.
  mixpanel
  /// Resend, through Resend's own MCP server and its OAuth.
  resend
  /// Replicate, through Replicate's own MCP server and its OAuth.
  replicate
  /// OpenRouter, through OpenRouter's own MCP server and its OAuth.
  openrouter
  /// PostHog, through PostHog's own MCP server and its OAuth.
  posthog
  /// DataForSEO, through DataForSEO's own MCP server and its OAuth.
  dataforseo
  /// Ahrefs, through Ahrefs' own MCP server and its OAuth.
  ahrefs
  /// An MCP server a member added by its URL. Its App keeps the server (App.mcp).
  mcp
  /// Search Console and Analytics (GA4), on Brigade's Google client like Gmail.
  google_search_console
  google_analytics
  /// Brigade's own addresses on its mail domain (mails.brigade.lol), received and sent through
  /// Resend with Brigade's key: an agent's address, or a project's inbox. No credential.
  email
}

/// Brigade registered as an OAuth client of an MCP server's authorization server
/// (dynamic client registration), once per server and callback URL.
model McpClient {
  id           String   @id @default(cuid())
  issuer       String
  redirectUri  String
  clientId     String
  /// Set only when the server gave the client a secret; Brigade asks for a public client.
  clientSecret String?
  createdAt    DateTime @default(now())

  @@unique([issuer, redirectUri])
}

/// An external account and a reference to its vault secret.
enum ConnectionStatus {
  active
  needs_reauth
  /// Kept so its call log survives; its credential is deleted.
  removed
}

/// Where a teammate may use an account. mine: only in threads the member who
/// connected it started. workspace: in every thread.
enum ConnectionReach {
  mine
  workspace
}

/// An App added to the workspace ("Apps" in the dashboard). Its accounts are its
/// connections. key: a connector kind for built-in Apps, custom:<id> for a custom app,
/// mcp:<hash of its URL> for an MCP server added by its URL.
model App {
  id                String       @id @default(cuid())
  organizationId    String
  workspaceId       String
  workspace         Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key               String
  /// A custom app's name. Built-in Apps take theirs from the catalog.
  name              String?
  /// An MCP server added by its URL: where it is, how its accounts sign in, the prefix of
  /// its tools' names and the tools it last listed (see src/mcp-servers.ts). Never a secret.
  mcp               Json?
  /// Operations no teammate gets, on every account of the App.
  disabledTools     String[]     @default([])
  createdByMemberId String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  connections       Connection[]
  /// The skills that come with it, imported when its first account connects.
  skillPacks        SkillPack[]

  @@unique([workspaceId, key])
}

model Connection {
  id                String           @id @default(cuid())
  organizationId    String
  workspaceId       String
  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appId             String
  /// An App keeps its removed accounts, for their call logs: it is never deleted on its own.
  app               App              @relation(fields: [appId], references: [id], onDelete: NoAction)
  reach             ConnectionReach  @default(workspace)
  /// Gmail: its mail shows in the Inbox, for everyone in the workspace. Only while it is shared
  /// (reach workspace), and only when its owner or an admin says so: a shared account may still
  /// hold someone's personal mail.
  inbox             Boolean          @default(false)
  kind              ConnectorKind
  label             String
  /// The external account, e.g. the mailbox address. Never a credential.
  externalAccount   String?
  /// Where a person manages the account at the provider, e.g. a GitHub installation's settings.
  externalUrl       String?
  /// The MCP server the account signed in to, when its App has one per data region (Mixpanel).
  mcpUrl            String?
  status            ConnectionStatus @default(active)
  vaultSecretId     String?          @unique
  vaultSecret       VaultSecret?     @relation(fields: [vaultSecretId], references: [id], onDelete: SetNull)
  createdByMemberId String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  grants            Grant[]
  calls             ConnectionCall[]
  replyWatches      ReplyWatch[]
  triggers          Trigger[]
  subscriptions     Subscription[]
  attachments       Attachment[]
  /// The Email App: the address this account is (an agent's, or a project's inbox).
  mailAddress       MailAddress?
  /// Gmail: its mail as the Inbox lists it, kept as the inbox reader reads it.
  mailMessages      MailMessage[]

  @@index([workspaceId])
  @@index([appId])
}

/// One encrypted secret. Decrypted only inside the API process.
model VaultSecret {
  id              String           @id @default(cuid())
  organizationId  String
  workspaceId     String
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ciphertext      Bytes
  iv              Bytes
  authTag         Bytes
  keyVersion      Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  connection      Connection?
  credential      Credential?
  previousOf      Credential?      @relation("CredentialPrevious")
  previewVariable PreviewVariable?

  @@index([workspaceId])
}

enum CredentialKind {
  website
  database
  api_key
  other
}

enum CredentialAccess {
  all
  selected
}

/// A secret a member keeps for teammates: a website login, a database, an API key.
/// all: every teammate may use it; selected: only teammates with a CredentialGrant.
/// A teammate may use it in a thread where a member mentioned it, once a person
/// approves, or always when its grant lets it use the credential without asking.
model Credential {
  id                    String            @id @default(cuid())
  organizationId        String
  workspaceId           String
  workspace             Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind                  CredentialKind
  name                  String
  /// Non-secret fields: URL, username, host, port, database. Never the secret.
  details               Json              @default("{}")
  access                CredentialAccess  @default(all)
  vaultSecretId         String            @unique
  vaultSecret           VaultSecret       @relation(fields: [vaultSecretId], references: [id], onDelete: Cascade)
  /// The secret before its last replacement, to roll back to.
  previousVaultSecretId String?           @unique
  previousVaultSecret   VaultSecret?      @relation("CredentialPrevious", fields: [previousVaultSecretId], references: [id], onDelete: SetNull)
  /// The member who added it, or who approved a teammate saving it. They may change it.
  createdByMemberId     String
  /// Set when a teammate saved it.
  createdByTeammateId   String?
  createdByTeammate     Teammate?         @relation(fields: [createdByTeammateId], references: [id], onDelete: SetNull)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  grants                CredentialGrant[]

  @@index([workspaceId])
}

/// Permission for one teammate to use one credential.
model CredentialGrant {
  id             String     @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  credentialId   String
  credential     Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  teammateId     String
  teammate       Teammate   @relation(fields: [teammateId], references: [id], onDelete: Cascade)
  /// Use it in any thread without a mention or a person's approval.
  withoutAsking  Boolean    @default(false)
  createdAt      DateTime   @default(now())

  @@unique([credentialId, teammateId])
  @@index([teammateId])
}

enum GrantScope {
  read
  read_write
}

/// Permission for one teammate to use one connection.
model Grant {
  id             String     @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  teammateId     String
  teammate       Teammate   @relation(fields: [teammateId], references: [id], onDelete: Cascade)
  connectionId   String
  connection     Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  scope          GrantScope
  createdAt      DateTime   @default(now())

  @@unique([teammateId, connectionId])
}

/// One connector call. Append-only.
model ConnectionCall {
  id                String     @id @default(cuid())
  organizationId    String
  workspaceId       String
  workspace         Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessionId         String
  session           Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  connectionId      String
  connection        Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  teammateId        String
  teammate          Teammate   @relation(fields: [teammateId], references: [id], onDelete: Cascade)
  operation         String
  write             Boolean
  target            String
  /// ok, denied, error, or awaiting_approval followed by its outcome in a later row.
  result            String
  error             String?
  /// The approval ticket, when a human decided.
  ticketId          String?
  /// A playbook's dry run: recorded, answered with a fake success, never sent.
  simulated         Boolean    @default(false)
  /// In a playbook's thread: the action of its manifest the call is.
  playbookActionKey String?
  /// A simulated call's input, for the dry run's report: what would have been sent.
  input             Json?
  createdAt         DateTime   @default(now())

  @@index([sessionId])
  @@index([connectionId, createdAt])
  @@index([teammateId, connectionId, createdAt])
}

/// An event on a connection that starts a thread for a teammate, chosen from the
/// connector's catalog (e.g. "stripe.payment_received"), or any event posted to a
/// custom app's URL ("webhook.received").
model Trigger {
  id                     String                @id @default(cuid())
  organizationId         String
  workspaceId            String
  workspace              Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId           String
  connection             Connection            @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  teammateId             String
  teammate               Teammate              @relation(fields: [teammateId], references: [id], onDelete: Cascade)
  label                  String
  /// The catalog id, e.g. gmail.email_received.
  event                  String
  /// What the teammate does with each event: the first lines of each thread it starts.
  instructions           String?
  /// The trigger's options from the catalog, e.g. { "query": "to:support@acme.com" }.
  options                Json                  @default("{}")
  /// Custom apps only: the unguessable part of the trigger's URL.
  pathToken              String?               @unique
  /// Custom apps only: how the sender is verified.
  verification           TriggerVerification?
  /// Custom apps only: the hmac signing secret, in the vault.
  verificationSecretId   String?
  /// Runs on this member's accounts.
  createdByMemberId      String
  /// The threads it starts are in this project.
  projectId              String?
  project                Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Set when a playbook made it: changed only through the playbook, deleted with it.
  playbookInstallationId String?
  playbookInstallation   PlaybookInstallation? @relation(fields: [playbookInstallationId], references: [id], onDelete: Cascade)
  /// Its place among its mailbox's rules: an email goes to the first rule that matches it.
  position               Int                   @default(0)
  createdAt              DateTime              @default(now())
  sessions               Session[]
  deliveries             TriggerDelivery[]

  @@index([workspaceId])
  @@index([connectionId])
}

enum TriggerVerification {
  /// X-Brigade-Signature: sha256=<hex HMAC of the body>.
  hmac
  /// The URL alone, for apps that sign nothing.
  none
}

/// How Brigade hears about a connection's events: a registration at the vendor
/// (push) or, where the vendor cannot push to this server, a poll. One per
/// connection and resource (the inbox, a calendar, the Stripe account).
model Subscription {
  id                 String           @id @default(cuid())
  organizationId     String
  workspaceId        String
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId       String
  connection         Connection       @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// stripe: "account". gmail: "inbox". google_calendar: the calendar id.
  resource           String
  mode               SubscriptionMode
  /// The vendor's id for it: a Stripe endpoint, a Calendar channel.
  externalId         String?
  /// Calendar: the channel's resource id, needed to stop it.
  externalResourceId String?
  /// The vendor's signing secret or channel token, in the vault.
  secretId           String?
  /// Vendor events it covers (Stripe event types).
  events             String[]
  /// Where reading changes resumes: Gmail's history id, Calendar's sync token.
  cursor             String?
  /// When the vendor drops it unless renewed (Gmail watch, Calendar channel).
  expiresAt          DateTime?
  /// The last failure to subscribe or read, shown on the connection.
  error              String?
  /// When its reader tries again: set before each read and cleared once it finished, so a read a
  /// restart cut off, or one that failed, is tried again by the minute's tick.
  retryAt            DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([connectionId, resource])
  @@index([workspaceId])
}

enum SubscriptionMode {
  /// The vendor sends events to Brigade.
  push
  /// Brigade asks every minute: the vendor cannot reach this server.
  poll
}

// ---------------------------------------------------------------------------
// Control and oversight
// ---------------------------------------------------------------------------

enum TicketType {
  approval
  question
  /// A ticket the teammate opened itself (open_ticket): one or more asks.
  request
  sign_in
  cap
  usage_limit
  /// A cloud computer's disk is still full after its runner freed what it could.
  disk_full
}

enum TicketStatus {
  open
  approved
  denied
  resolved
}

/// Something waiting on a human.
model Ticket {
  id                 String       @id @default(cuid())
  organizationId     String
  workspaceId        String
  workspace          Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessionId          String?
  session            Session?     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type               TicketType
  status             TicketStatus @default(open)
  title              String
  payload            Json         @default("{}")
  resolvedByMemberId String?
  resolvedAt         DateTime?
  createdAt          DateTime     @default(now())

  @@index([workspaceId, status])
  @@index([sessionId])
}

/// Metadata and text-index entry for a library file.
enum DocumentKind {
  library
  workspace_memory
  teammate_memory
  thread_summary
  project_memory
}

/// A library file (its bytes in the bucket, its text here), a memory file or a
/// thread summary (text only). `search` is generated from path and text.
model Document {
  id                 String                   @id @default(cuid())
  organizationId     String
  workspaceId        String
  workspace          Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind               DocumentKind             @default(library)
  /// Library: the file's path. Memory: workspace.md, teammates/<id>.md, projects/<id>.md or threads/<id>.md.
  path               String
  /// Set for a project's memory.
  projectId          String?
  project            Project?                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Set for a teammate's memory and a thread summary.
  teammateId         String?
  teammate           Teammate?                @relation(fields: [teammateId], references: [id], onDelete: Cascade)
  /// Set for a thread summary.
  sessionId          String?
  session            Session?                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  contentType        String
  size               Int
  /// SHA-256 of the stored bytes (library) or of the text (memory).
  sha256             String                   @default("")
  text               String                   @default("")
  /// Whether the text could be read for search.
  indexed            Boolean                  @default(false)
  /// Generated by PostgreSQL (see the library_memory migration); never written.
  search             Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('simple'::regconfig, translate(path, '/._-'::text, '    '::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, text), 'B'::\"char\"))"))
  /// Who added a library file, and who changed it last: a member or a teammate.
  createdByType      ActorType?
  createdById        String?
  updatedByType      ActorType?
  updatedById        String?
  /// The thread a teammate last changed it from.
  updatedInSessionId String?
  /// A memory file: when a tidy run last laid it out (core within budget, topics, archive).
  memoryTidiedAt     DateTime?
  /// Set while a library file is in the trash. Its path is then ".trash/<id>/<path it had>",
  /// which no live file can have; the hourly sweep deletes it 30 days on.
  deletedAt          DateTime?
  deletedByType      ActorType?
  deletedById        String?
  updatedAt          DateTime                 @updatedAt
  createdAt          DateTime                 @default(now())
  assets             DocumentAsset[]
  versions           DocumentVersion[]
  memoryLines        MemoryLine[]
  /// The members who pinned it.
  pins               DocumentPin[]

  /// Its checklist lines that work is attached to (docs/lists.md).
  listItems ListItem[]

  @@unique([workspaceId, kind, path])
  @@index([search], type: Gin)
  @@index([workspaceId, deletedAt])
}

/// A checklist line of a library Markdown file that work is attached to (docs/lists.md). The file
/// holds the line itself, marked `<!-- item:<id> -->` at its end, and whether it is ticked; this
/// row holds what the file cannot: the threads working on it, the pull requests that finish it,
/// and who ticked it from Brigade.
model ListItem {
  /// The id in its marker: made when a line is first handed to a teammate, linked or added.
  id             String           @id
  organizationId String
  workspaceId    String
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documentId     String
  document       Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// The line as last seen, without its checkbox and marker: for threads while the file is out of reach.
  text           String
  /// Who ticked it from Brigade (a teammate's complete_item, a merged pull request), and when.
  /// A person ticks it in the file; the file says whether it is ticked, never this.
  doneByType     ActorType?
  doneById       String?
  doneAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  threads        ListItemThread[]
  pulls          ListItemPull[]

  @@index([documentId])
}

/// A thread working on a list item. A thread can carry several items, an item several threads.
model ListItemThread {
  organizationId String
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  itemId         String
  item           ListItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sessionId      String
  session        Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())

  @@id([itemId, sessionId])
  @@index([sessionId])
}

/// A pull request that works on a list item: `closes` ticks the item once it is merged; else it is
/// only part of the work, shown on the line.
model ListItemPull {
  organizationId String
  workspaceId    String
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  itemId         String
  item           ListItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  pullRequestId  String
  pullRequest    PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  closes         Boolean     @default(false)
  createdAt      DateTime    @default(now())

  @@id([itemId, pullRequestId])
  @@index([pullRequestId])
}

/// A library file a member pinned: it stays at the top of their Library. Each member's own,
/// like a thread's pin. A file in the trash keeps its pin, which shows again once restored.
model DocumentPin {
  organizationId String
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  documentId     String
  document       Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pinnedAt       DateTime  @default(now())

  @@id([memberId, documentId])
  @@index([documentId])
}

/// A saved state of a library file. Its bytes are in the bucket under
/// <organization>/<workspace>/library-versions/<id>; the newest is also the file itself.
/// Saves by the same author from the same thread within minutes update one version.
/// One line of a memory file, known by its text (memoryLineKey): when and where
/// it was learned and, once it left the file, why. Lines that left (replaced,
/// merged, outdated, removed by a person) are the memory's archive: search finds
/// them and people can put them back. The file's text stays the source of truth.
model MemoryLine {
  id                String                   @id @default(cuid())
  organizationId    String
  workspaceId       String
  documentId        String
  document          Document                 @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// A SHA-256 of the line as compared (no bullet, any case, any spacing), so any length fits the index.
  key               String
  /// The line as last written, without its bullet.
  text              String
  /// The topic it is (or was last) under; null for the core.
  topic             String?
  /// Who wrote it: a teammate's memory run, or a person in the editor. Null when
  /// it was in the file before memory kept dates (legacy).
  createdByType     ActorType?
  createdById       String?
  /// The thread it was learned in.
  sessionId         String?
  createdAt         DateTime                 @default(now())
  /// There before memory kept dates: learned before createdAt.
  legacy            Boolean                  @default(false)
  /// The last time a thread found it still true.
  confirmedAt       DateTime?
  /// Set while it is out of the file.
  archivedAt        DateTime?
  archivedReason    String?
  archivedByType    ActorType?
  archivedById      String?
  archivedSessionId String?
  /// Generated by PostgreSQL (see the memory_lines migration); never written.
  search            Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::regconfig, text)"))

  @@unique([documentId, key])
  @@index([documentId, archivedAt])
  @@index([search], type: Gin)
}

model DocumentVersion {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String
  documentId     String
  document       Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// Where the file was when saved.
  path           String
  contentType    String
  size           Int
  sha256         String
  actorType      ActorType
  actorId        String
  sessionId      String?
  /// Set when this version brought back an older one.
  restoredFromId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([documentId, createdAt])
}

/// A library folder someone made, or one with access rules. Folders also exist
/// implicitly, as the paths of the files in them.
model LibraryFolder {
  id             String               @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// "hr" or "hr/payroll": no leading or trailing slash.
  path           String
  /// Teammates reach it only through a grant on it or on a folder inside it.
  restricted     Boolean              @default(false)
  createdByType  ActorType?
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  grants         LibraryFolderGrant[]

  @@unique([workspaceId, path])
}

/// A teammate's access to a folder and everything in it, over its default library access.
model LibraryFolderGrant {
  id             String        @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folderId       String
  folder         LibraryFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  teammateId     String
  teammate       Teammate      @relation(fields: [teammateId], references: [id], onDelete: Cascade)
  access         LibraryAccess

  @@unique([folderId, teammateId])
  @@index([teammateId])
}

/// A file put in a document from the editor: an image, a video, a recording, a PDF. Its bytes
/// are in the bucket under <organization>/<workspace>/assets/<id>; the document refers to it as
/// `asset:<id>`. The hourly sweep removes the ones no document refers to any more.
model DocumentAsset {
  id                 String           @id @default(cuid())
  organizationId     String
  /// No relation: a deleted workspace's assets are found by the sweep and their bytes removed.
  workspaceId        String
  /// The document it was added to. Null once that document is gone; another document that
  /// refers to it (a block copied over) takes it on, or the sweep removes it.
  documentId         String?
  document           Document?        @relation(fields: [documentId], references: [id], onDelete: SetNull)
  name               String
  contentType        String
  size               Int
  /// Read back from the bucket once its upload finished; empty for files from before.
  sha256             String           @default("")
  status             AttachmentStatus @default(ready)
  uploadedByMemberId String?
  createdAt          DateTime         @default(now())
  /// When the sweep last found a document referring to it.
  checkedAt          DateTime?

  @@index([documentId])
  @@index([workspaceId])
  @@index([checkedAt])
}

enum ActorType {
  member
  teammate
  runner
  system
}

/// A deleted thread's files folder in the bucket, emptied again once every signed upload
/// URL issued before its deletion has expired (a runner's late image, runner-files.ts).
/// Kept until a sweep empties it whole: the row is the promise that nothing is left.
model BucketCleanup {
  id        String   @id @default(cuid())
  sessionId String   @unique
  prefix    String
  /// Not before this: a URL issued just before the deletion works until then.
  notBefore DateTime
  createdAt DateTime @default(now())

  @@index([notBefore])
}

/// A deleted workspace's folder in the bucket (`<org>/<ws>/`), emptied by a sweep in batches
/// (src/workspace-delete.ts), and again once every signed upload URL issued before its deletion
/// has expired. Written with the deletion itself: the row is the promise that nothing is left,
/// and goes only once a listing after that margin finds the folder empty.
model WorkspaceCleanup {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String   @unique
  prefix         String
  /// When the workspace was deleted: the folder is empty for good once listed empty a margin after.
  notBefore      DateTime
  createdAt      DateTime @default(now())

  @@index([notBefore])
}

/// Append-only record of an action. workspaceId is null for organization-level actions.
model AuditEntry {
  id             BigInt     @id @default(autoincrement())
  organizationId String
  workspaceId    String?
  workspace      Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorType      ActorType
  actorId        String
  action         String
  targetType     String
  targetId       String
  data           Json?
  at             DateTime   @default(now())

  @@index([workspaceId, at])
  @@index([organizationId, at])
}

// ---------------------------------------------------------------------------
// Attachments: files given to threads, from a person's computer or a connection
// ---------------------------------------------------------------------------

enum AttachmentSource {
  /// A member uploaded it in the dashboard.
  upload
  /// It came with an event or a call on a connection (an email's attachment).
  connector
  /// A teammate sent it from its working folder (e.g. attached to an email it sends).
  teammate
}

enum AttachmentStatus {
  /// A member's browser is uploading it straight to the bucket; not checked yet.
  pending
  /// The bytes are in the bucket.
  ready
  /// Not stored: too large, a type Brigade does not take from outside, or it could not be fetched.
  blocked
}

/// A file's bytes (in the bucket, keyed by id) and where they came from. One
/// file can be in several threads, e.g. an email two triggers matched.
/// A file uploaded straight to the bucket (uploads.ts), held under `uploadKey` until it is used:
/// saved to the library, read as a skill pack, kept as a skill's file or a logo. The sweep
/// removes those never used, bytes first.
model Upload {
  id             String           @id @default(cuid())
  organizationId String
  /// No relation: a deleted workspace's uploads are found by the sweep and their bytes removed.
  workspaceId    String
  /// library, skill_pack, skill_file or logo (UPLOAD_PURPOSES).
  purpose        String
  /// The file's name, or its library path.
  name           String
  contentType    String
  size           Int
  /// The runner's, checked once the bytes are in; else the bytes' own, read then.
  sha256         String           @default("")
  /// pending until its bytes are checked, then ready; blocked once used, refused or abandoned.
  status         AttachmentStatus @default(pending)
  /// Who started it: a member, or a runner for a teammate of a thread on its computer.
  memberId       String?
  computerId     String?
  sessionId      String?
  teammateId     String?
  /// Read at completion for a library file, for search.
  text           String           @default("")
  /// The completion that marked it ready: its checked bytes are at checkedUploadKey(id, checked).
  checked        String           @default("")
  createdAt      DateTime         @default(now())

  @@index([workspaceId, createdAt])
  @@index([createdAt])
}

model Attachment {
  id                 String             @id @default(cuid())
  organizationId     String
  workspaceId        String
  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// The file's name, made safe: no folders, no hidden or control characters.
  name               String
  contentType        String
  size               Int
  sha256             String             @default("")
  status             AttachmentStatus   @default(ready)
  /// Why it is blocked.
  note               String?
  source             AttachmentSource
  uploadedByMemberId String?
  connectionId       String?
  connection         Connection?        @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  /// The vendor's stable name for it, e.g. gmail:<messageId>:<partId>: fetched once.
  externalRef        String?
  /// Set for a file a teammate sent: the thread it was sent from.
  sessionId          String?
  session            Session?           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// Extracted for search, like a library file's.
  text               String             @default("")
  createdAt          DateTime           @default(now())
  threads            ThreadAttachment[]

  @@unique([connectionId, externalRef])
  @@index([workspaceId, createdAt])
}

/// A file in a thread: copied into each teammate's working folder at `path` before its turn.
model ThreadAttachment {
  id             String     @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessionId      String
  session        Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attachmentId   String
  attachment     Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  /// Relative to a teammate's working folder, e.g. attachments/invoice.pdf. Decided by the API.
  path           String
  createdAt      DateTime   @default(now())

  @@unique([sessionId, path])
  @@unique([sessionId, attachmentId])
  @@index([attachmentId])
}

/// A design system: rules, tokens and assets in a library folder, and where it applies.
/// Teammates making a design pick one: named in the message, then by the library folder
/// the design goes in, the repository the thread works in, the teammate, the default.
model DesignSystem {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  description    String    @default("")
  /// Its library folder, e.g. "design-systems/acme".
  path           String
  /// Applies where nothing more specific does. At most one per workspace.
  isDefault      Boolean   @default(false)
  /// Library folders whose designs follow it.
  folders        String[]
  /// Repositories (owner/name, lowercase) whose threads follow it.
  repositories   String[]
  /// Teammates who follow it by default. Archived ones are skipped.
  teammateIds    String[]
  /// Projects whose threads follow it.
  projectIds     String[]  @default([])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

/// How the workspace does a kind of work, loaded by a teammate when the work
/// calls for it: written into its harness's skills folder (SKILL.md) as each
/// session starts. Its text is here; the files beside it are in the bucket by
/// their SHA-256, not in the library, which any member may edit. A skill gives
/// no access; grants stay where they are.
model Skill {
  id             String     @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// A slug: the folder name, and `/name` in the composer.
  name           String
  /// When to use it: what the teammate reads to decide.
  description    String
  instructions   String
  /// Files beside SKILL.md, in the bucket: [{ path, sha256, size }]. Before packs: [{ path, content }].
  files          Json       @default("[]")
  /// The pack it came in: then its pack's scope applies, and its switch too.
  packId         String?
  pack           SkillPack? @relation(fields: [packId], references: [id], onDelete: Cascade)
  /// Every thread, or only those of the teammates and projects below.
  everywhere     Boolean    @default(true)
  teammateIds    String[]   @default([])
  projectIds     String[]   @default([])
  enabled        Boolean    @default(true)
  /// Who wrote it, and who changed it last: a member, or a teammate whose proposal a member approved.
  createdByType  ActorType
  createdById    String
  updatedByType  ActorType
  updatedById    String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([packId])
}

/// Skills imported together (a GitHub repository, a zip), kept as one: one
/// scope, written onto its skills, and one switch over theirs.
model SkillPack {
  id                     String                @id @default(cuid())
  organizationId         String
  workspaceId            String
  workspace              Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                   String
  /// A GitHub address, or `file:<name>` for an upload: importing it again updates the pack.
  source                 String
  everywhere             Boolean               @default(true)
  teammateIds            String[]              @default([])
  projectIds             String[]              @default([])
  enabled                Boolean               @default(true)
  createdByType          ActorType
  createdById            String
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  skills                 Skill[]
  /// Set when the pack came with an App: its skills load only for teammates with that App.
  appId                  String?
  app                    App?                  @relation(fields: [appId], references: [id], onDelete: SetNull)
  /// Set when a playbook installed it: its skills load only in that playbook's threads.
  playbookInstallationId String?
  playbookInstallation   PlaybookInstallation? @relation(fields: [playbookInstallationId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, source])
  @@index([workspaceId])
}

/// How a repository's preview starts (PreviewRecipe in contracts), saved by a
/// teammate once it passed its check; later threads start it in one step.
model PreviewRecipe {
  id                 String    @id @default(cuid())
  organizationId     String
  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// owner/name, lowercase.
  repository         String
  recipe             Json
  savedByTeammateId  String?
  /// The thread it was saved from.
  savedFromSessionId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([workspaceId, repository])
  @@index([workspaceId])
}

enum PreviewVariableKind {
  setting
  secret
  generated
}

/// A variable people give a repository's preview: each start puts it in the
/// app's environment. A secret's value is sealed in the vault, never shown again.
model PreviewVariable {
  id                String              @id @default(cuid())
  organizationId    String
  workspaceId       String
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// owner/name, lowercase.
  repository        String
  name              String
  kind              PreviewVariableKind
  /// A setting's value. Never a secret's.
  value             String?
  /// A secret's (or a generated one's) value.
  vaultSecretId     String?             @unique
  vaultSecret       VaultSecret?        @relation(fields: [vaultSecretId], references: [id], onDelete: Cascade)
  /// What the app uses it for, as the teammate that asked for it said.
  description       String?
  updatedByMemberId String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([workspaceId, repository, name])
  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

/// A line of work inside a workspace: its threads, tasks, library folder and
/// repositories. Organizing and context only: every workspace resource stays shared.
model Project {
  id                     String                 @id @default(cuid())
  organizationId         String
  workspaceId            String
  workspace              Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                   String
  /// One letter or an emoji, shown in the sidebar. Unset: the name's first letter.
  icon                   String?
  /// Its logo in the bucket (projectLogoKey), shown instead of the icon: "<version>.<type>",
  /// e.g. "k2x9f1.png". Unset: none.
  logo                   String?
  /// The website the project is about, if it has one.
  url                    String?
  /// Given to every thread in the project: what it is, its stack, who it is for.
  brief                  String                 @default("")
  /// Its library folder, e.g. "Projects/Acme web". Files belong to it by path.
  folder                 String?
  /// Connections its threads should use when several could do. A hint, not a grant.
  preferredConnectionIds String[]               @default([])
  /// Whether its pull requests get a review by another teammate.
  reviewPolicy           ReviewPolicy           @default(teammate)
  archivedAt             DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  repositories           ProjectRepository[]
  sessions               Session[]
  tasks                  Task[]
  schedules              Schedule[]
  triggers               Trigger[]
  documents              Document[]
  playbookInstallations  PlaybookInstallation[]
  /// Its name in its agents' addresses (riley.<slug>@), once one was used.
  mailProject            MailProject?

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

/// A GitHub repository a project works on. A repository may be in several projects.
model ProjectRepository {
  organizationId String
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// owner/name, lowercase, as PreviewRecipe and PullRequest store it.
  repository     String
  createdAt      DateTime  @default(now())

  @@id([projectId, repository])
  @@index([workspaceId, repository])
}

// ---------------------------------------------------------------------------
// Notifications: web push to the dashboard installed as an app (src/notifications.ts)
// ---------------------------------------------------------------------------

/// What a member is notified of. needed: what waits on them. finished: and each
/// task done or pull request merged. everything: and replies in threads they started.
enum NotifyPreset {
  needed
  finished
  everything
}

/// A browser or installed app that receives a user's notifications, from PushManager.subscribe.
model PushDevice {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// One thing a member was or will be notified of, by key (needs:<threadId>,
/// done:<taskId>, merged:<pullRequestId>, reply:<threadId>:<at>): so each is
/// sent once, reminded at most once, and its notification closed once resolved.
model PushNotice {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  key            String
  /// When it was first seen; it is sent once it has lasted a while.
  firstSeenAt    DateTime  @default(now())
  /// Sent (or seen in the dashboard, so never sent).
  sentAt         DateTime?
  /// Whether sentAt was a push, which counts toward the hourly cap.
  pushed         Boolean   @default(false)
  remindedAt     DateTime?
  /// No longer waiting: its notification is closed with the next push.
  resolvedAt     DateTime?
  /// That push went out.
  closedAt       DateTime?

  @@unique([memberId, key])
  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Playbooks ("boucles"): a whole job to install (src/playbooks.ts). A template ships with
// the API (apps/api/playbooks/<id>/playbook.yaml); an installation runs it in a workspace.
// ---------------------------------------------------------------------------

enum PlaybookStatus {
  /// Its settings are being filled in, or it waits for an owner or admin to activate it.
  setup
  dry_run
  active
  paused
}

/// ask: a person approves each time. auto: the teammate acts alone. deny: never.
enum PlaybookActionLevel {
  ask
  auto
  deny
}

enum PlaybookRunStatus {
  running
  waiting_person
  waiting_event
  done
  failed
}

/// A playbook installed in a workspace (and a project): it runs for one teammate on its
/// owner's accounts. Its triggers, schedules and skill pack are its own and go with it.
model PlaybookInstallation {
  id                  String           @id @default(cuid())
  organizationId      String
  workspaceId         String
  workspace           Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId           String?
  project             Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// The template's id, e.g. brigade/support-bugs.
  playbookKey         String
  version             String
  /// brigade: shipped with the API. Later, a GitHub repository.
  source              String           @default("brigade")
  /// The template as installed (PlaybookManifest).
  manifest            Json
  teammateId          String
  teammate            Teammate         @relation(fields: [teammateId], references: [id], onDelete: Cascade)
  /// Runs on this member's accounts: their Claude or Codex subscription and their own Apps.
  ownerMemberId       String
  owner               Member           @relation(fields: [ownerMemberId], references: [id], onDelete: Cascade)
  /// The answers to the template's settings, by key.
  settings            Json             @default("{}")
  status              PlaybookStatus   @default(setup)
  createdByMemberId   String
  activatedAt         DateTime?
  activatedByMemberId String?
  pausedAt            DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  actions             PlaybookAction[]
  runs                PlaybookRun[]
  triggers            Trigger[]
  schedules           Schedule[]
  skillPacks          SkillPack[]
  dryRuns             PlaybookDryRun[]

  @@index([workspaceId])
  @@index([projectId])
}

/// One write a playbook may make, at its level of autonomy. Its numbers come from ConnectionCall and tickets.
model PlaybookAction {
  id                     String               @id @default(cuid())
  organizationId         String
  workspaceId            String
  workspace              Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installationId         String
  installation           PlaybookInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  key                    String
  level                  PlaybookActionLevel
  /// Limits on auto: { cases?: string[], checksPassed?: true, max?: { argument: number } }.
  conditions             Json                 @default("{}")
  /// Daily caps on auto: { count?: number, amount?: { argument: string, max: number } }. Past
  /// one, the action asks until the next day.
  limits                 Json                 @default("{}")
  levelChangedAt         DateTime?
  levelChangedByMemberId String?
  /// Why it last went back to ask on its own: flagged, update, cap.
  demotedReason          String?

  @@unique([installationId, key])
}

/// One event's work: its root thread (origin trigger or schedule) and the root's children.
/// A later event of the same conversation continues it.
model PlaybookRun {
  id              String               @id @default(cuid())
  organizationId  String
  workspaceId     String
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installationId  String
  installation    PlaybookInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  /// Set once its thread started; a run whose thread could not start has none.
  rootSessionId   String?              @unique
  rootSession     Session?             @relation("PlaybookRunRoot", fields: [rootSessionId], references: [id], onDelete: SetNull)
  /// The trigger's conversation (e.g. a Gmail thread): its later events continue this run.
  conversationKey String?
  /// The triage case the teammate reported (playbook_report).
  case            String?
  status          PlaybookRunStatus    @default(running)
  /// resolved, escalated, noise or failed, from playbook_report.
  outcome         String?
  /// Times a person stepped in: a ticket resolved by a person, a member's message.
  interventions   Int                  @default(0)
  firstResponseAt DateTime?
  dryRun          Boolean              @default(false)
  /// A dry run's: the replay it is one event of.
  dryRunId        String?
  dryRunOf        PlaybookDryRun?      @relation(fields: [dryRunId], references: [id], onDelete: Cascade)
  /// A dry run's event waiting its turn: its thread's title, first message, files and time.
  replay          Json?
  /// What the teammate said it did (playbook_report's summary).
  summary         String?
  startedAt       DateTime             @default(now())
  endedAt         DateTime?
  threads         Session[]            @relation("PlaybookRunThreads")

  @@index([installationId, startedAt])
  @@index([installationId, conversationKey])
  @@index([dryRunId])
}

/// A playbook replaying past events with every write simulated, before it is activated.
/// Its runs (PlaybookRun.dryRun) start a few at a time; the thread it was started from hears
/// once they are all done.
model PlaybookDryRun {
  id                String               @id @default(cuid())
  organizationId    String
  workspaceId       String
  workspace         Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installationId    String
  installation      PlaybookInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  /// The thread it was started from, which hears when it is done.
  sessionId         String?
  session           Session?             @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  /// The teammate there that started it, woken with the report.
  teammateId        String
  startedByMemberId String
  /// running, done, or failed (nothing to replay, or it could not start).
  status            String               @default("running")
  error             String?
  /// The span of the replayed events, for the week's extrapolation.
  firstEventAt      DateTime?
  lastEventAt       DateTime?
  startedAt         DateTime             @default(now())
  endedAt           DateTime?
  runs              PlaybookRun[]

  @@index([installationId, startedAt])
  @@index([status])
}

/// A thread waiting on another's report without being its parent (follow_thread): three runs of
/// a playbook whose customers hit the same bug follow the one fix. The followed thread's report
/// wakes each follower once, like a parent (src/children.ts).
model ThreadFollow {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// The thread followed.
  sessionId      String
  session        Session   @relation("ThreadFollowed", fields: [sessionId], references: [id], onDelete: Cascade)
  /// The thread that waits.
  followerId     String
  follower       Session   @relation("ThreadFollower", fields: [followerId], references: [id], onDelete: Cascade)
  /// When the followed thread's report reached the follower; a new report clears it.
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  @@unique([sessionId, followerId])
  @@index([followerId])
}

// ---------------------------------------------------------------------------
// Email: Brigade's own addresses on its mail domain (the Email App)
// ---------------------------------------------------------------------------

enum MailAddressKind {
  /// An agent's: riley@, with a variant per project (riley.lovarank@) and per sign-up.
  agent
  /// A project's shared mailbox, such as the one support@ is forwarded to.
  inbox
}

/// An address on Brigade's mail domain: its name is the part before the first dot, in one
/// registry for all of Brigade. A name belongs to one agent or one project inbox, in one
/// workspace, and is never given to anyone else, even once its owner is gone: no link to the
/// workspace that could delete it, and none to the teammate or project either.
model MailAddress {
  id                String          @id @default(cuid())
  organizationId    String
  workspaceId       String
  /// Lowercase letters, digits and hyphens. Unique across Brigade, for good.
  name              String          @unique
  kind              MailAddressKind
  /// agent: whose address it is. One address per teammate, kept if it is turned off and on again.
  teammateId        String?         @unique
  /// inbox: the project it belongs to, whose threads alone use it.
  projectId         String?
  /// Its account in the Email App, which tools, grants, rules and the journal hang on. Null once
  /// the App or the account was removed: the address then receives nothing.
  connectionId      String?         @unique
  connection        Connection?     @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  /// inbox: the address customers write to, forwarded here (support@lovarank.com). Replies go out
  /// from it once its domain is verified.
  publicAddress     String?         @unique
  domainId          String?
  domain            MailDomain?     @relation(fields: [domainId], references: [id], onDelete: SetNull)
  /// inbox: the name on what it sends, e.g. "Lovarank support".
  displayName       String?
  /// When it stopped receiving (turned off, its agent or project gone). Its name stays reserved.
  releasedAt        DateTime?
  createdByMemberId String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  aliases           MailAlias[]
  messages          MailMessage[]

  @@index([workspaceId])
}

/// A project's name in its agents' addresses (riley.<slug>@): set the first time one is used,
/// then kept when the project is renamed or deleted, and never given to another project.
model MailProject {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slug           String
  /// Null once the project is deleted: mail to its variants goes nowhere.
  projectId      String?   @unique
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())

  @@unique([workspaceId, slug])
}

/// An address made for one sign-up (riley.lovarank.k3f9@): until waitUntil its mail goes to the
/// thread that asked for it, then to its box. Never deleted, so it never points elsewhere.
model MailAlias {
  id             String        @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// The whole part before the @, e.g. riley.lovarank.k3f9.
  local          String        @unique
  addressId      String
  address        MailAddress   @relation(fields: [addressId], references: [id], onDelete: Cascade)
  /// The variant it belongs to (the thread's project). Null: the address without a project.
  projectId      String?
  sessionId      String?
  session        Session?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  teammateId     String?
  /// What it is for, in the teammate's words ("Notion sign-up").
  purpose        String        @default("")
  waitUntil      DateTime
  createdAt      DateTime      @default(now())
  messages       MailMessage[]

  @@index([sessionId])
}

enum MailDirection {
  in
  out
}

enum MailStatus {
  /// in: kept from the webhook, not read and delivered yet.
  pending
  /// in: delivered where it goes (see route).
  done
  /// in: could not be read or delivered after several tries.
  failed
  /// out: handed to Resend, which sends it at sendAt (the window to cancel it).
  scheduled
  sent
  delivered
  bounced
  cancelled
}

enum MailSender {
  /// A member of the workspace whose address passed DKIM or DMARC.
  member
  /// Someone this workspace's mailboxes exchanged mail with before.
  contact
  unknown
  /// One of Brigade's own addresses, e.g. an agent writing to a project inbox.
  brigade
}

/// One email in a mailbox the workspace reads: one of Brigade's own addresses (an agent's, a
/// project's inbox), received or sent, or a shared Gmail account's, received (the Inbox's mail,
/// kept as Gmail's inbox reader reads it). Received mail left in its box is kept 30 days; mail
/// a thread took lives and goes with it.
model MailMessage {
  id                 String        @id @default(cuid())
  organizationId     String
  workspaceId        String
  workspace          Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Brigade's own address it came to or went from. Null for Gmail's mail.
  addressId          String?
  address            MailAddress?  @relation(fields: [addressId], references: [id], onDelete: Cascade)
  /// Gmail's mail: its account. It goes with the account.
  connectionId       String?
  connection         Connection?   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// Gmail's mail: Gmail's message id, so a mail read again is kept once.
  sourceId           String?
  /// The variant: the project of riley.<slug>@. Null: riley@ itself, or a project inbox.
  projectId          String?
  /// Address and variant ("<addressId>:<projectId or ->"): one copy per box of a mail sent to
  /// several of Brigade's addresses. Gmail's: "gmail:<connectionId>".
  box                String
  /// Received on a sign-up address.
  aliasId            String?
  alias              MailAlias?    @relation(fields: [aliasId], references: [id], onDelete: SetNull)
  direction          MailDirection
  status             MailStatus
  /// Resend's id for the email, received or sent.
  resendId           String?
  /// The RFC 5322 Message-ID, for threading. A sent email's comes once Resend reports it.
  messageId          String?
  inReplyTo          String?
  references         String[]      @default([])
  /// Brigade's id for its conversation: an email answering one of the box's takes its id.
  conversationId     String
  fromAddress        String
  fromName           String        @default("")
  to                 String[]      @default([])
  cc                 String[]      @default([])
  replyTo            String[]      @default([])
  subject            String        @default("")
  /// The plain text, up to 100 000 characters.
  text               String        @default("")
  /// The few headers Brigade reads (auto-submitted, precedence, list-id…), lower-cased.
  headers            Json          @default("{}")
  /// SPF, DKIM and DMARC as the receiving server computed them.
  authentication     Json?
  /// Sent by a machine (an out-of-office, a notification).
  automatic          Boolean       @default(false)
  sender             MailSender?
  memberId           String?
  contactId          String?
  contact            Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  /// Resend's attachments: [{ id, filename, contentType, size, inline }].
  attachments        Json          @default("[]")
  /// in: where it went. awaited (a thread waiting on it), conversation (its conversation's
  /// thread), member (a member's request), rule, box, duplicate, loop, cap, own_copy (a reply a
  /// person sent from Gmail), read (a thread read or answered it from the box), unknown_address.
  /// Null until delivered.
  route              String?
  routeNote          String?
  /// The thread that took it (in) or sent it (out). Deleted with it.
  sessionId          String?
  session            Session?      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  triggerId          String?
  /// out: the teammate that wrote it, and the member who approved or changed it.
  teammateId         String?
  approvedByMemberId String?
  /// out: when Resend sends it; it can be cancelled until then.
  sendAt             DateTime?
  /// The Inbox: a person marked it done (nothing more to do with it).
  doneAt             DateTime?
  doneByMemberId     String?
  /// The Inbox: the person who handed it to a teammate (its thread is sessionId, route handed).
  handedByMemberId   String?
  /// When it was handed over: the newest hand-over holds its conversation.
  handedAt           DateTime?
  /// in: what its thread did with it without replying, said with email_no_reply: no_reply (it
  /// chose not to answer: a person sees it To do) or handled (it did what it asked, no reply
  /// needed). A reply sent after it says the rest; a person asking for a reply clears it.
  outcome            String?
  /// The thread's reason, in a line, shown in the Inbox.
  outcomeNote        String?
  outcomeAt          DateTime?
  /// in: Brigade asked its thread what it did with it, once: a turn ended without a reply or an
  /// outcome (src/mail/outcomes.ts).
  outcomeAskedAt     DateTime?
  /// out: a person wrote and sent it from the Inbox (Reply myself), not the teammate.
  sentByMemberId     String?
  error              String?
  attempts           Int           @default(0)
  receivedAt         DateTime      @default(now())
  /// Left in its box: deleted then.
  expiresAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([resendId, box])
  @@unique([box, sourceId])
  /// The Inbox: a workspace's received mail, newest first.
  @@index([workspaceId, direction, receivedAt])
  @@index([workspaceId, conversationId])
  @@index([workspaceId, messageId])
  @@index([box, receivedAt])
  @@index([status, updatedAt])
  @@index([sessionId])
  @@index([expiresAt])
}

/// A domain of the workspace's own (lovarank.com) that its project inboxes send as, once its DNS
/// records are in place. One workspace per domain across Brigade.
model MailDomain {
  id                String        @id @default(cuid())
  organizationId    String
  workspaceId       String
  workspace         Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name              String        @unique
  resendDomainId    String?
  /// pending, verified or failed, as Resend last said.
  status            String        @default("pending")
  /// How its mail reaches Brigade: forward (its mail stays with its provider, Google's say, and each
  /// address is forwarded to its Brigade mailbox) or direct (its MX points to Brigade's receiving).
  receiving         String        @default("forward")
  /// The DNS records to add: [{ record, type, name, value, priority?, status }].
  records           Json          @default("[]")
  createdByMemberId String
  checkedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  addresses         MailAddress[]
}

/// Someone a workspace's mailboxes exchanged mail with, with each way to reach them.
model Contact {
  id             String          @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String          @default("")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  handles        ContactHandle[]
  messages       MailMessage[]
}

/// One way to reach a contact: an email address today, a chat account later.
model ContactHandle {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  /// email.
  kind           String
  /// Lower-cased.
  value          String
  lastSeenAt     DateTime  @default(now())

  @@unique([workspaceId, kind, value])
}

/// A problem with Brigade itself that its operators are alerted to (src/ops/): one row per
/// problem, by key, kept once resolved so it is not alerted again right away.
model OpsAlert {
  /// What it is about, e.g. api-errors or computer:<id>.
  key              String    @id
  /// critical or warning.
  severity         String
  title            String
  detail           String    @default("")
  firstAt          DateTime  @default(now())
  lastAt           DateTime  @default(now())
  /// When operators were last told about it, and how bad it was then.
  notifiedAt       DateTime?
  notifiedSeverity String?
  /// Null while it lasts.
  resolvedAt       DateTime?
}

enum HeldCallStatus {
  /// Its ticket is open.
  waiting
  /// A person decided; the call is made next (the minute's tick makes one a restart cut off).
  decided
  /// Being made. One left here by a restart is never made again: its thread is told.
  running
  done
  /// Its ticket closed without a decision for it.
  expired
}

/// A call a teammate made that waits for a person's decision in a ticket (src/held-calls.ts): an
/// App's write, a credential, a trigger. Kept so the decision is acted on whenever it comes, after
/// any restart of the API or the runner, exactly once; an identical call meanwhile joins its ticket.
model HeldCall {
  id             String         @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessionId      String
  session        Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teammateId     String
  ticketId       String         @unique
  /// connector, credential or trigger.
  kind           String
  /// SHA-256 of the kind, the teammate, the tool and its arguments. A partial unique index keeps
  /// one waiting call per thread and fingerprint (migration 20261027090000_durable_work).
  fingerprint    String
  /// The call as the runner sent it, without its callId. A secret to save is sealed in the vault.
  request        Json
  status         HeldCallStatus @default(waiting)
  /// The person's decision, once made.
  decision       Json?
  /// ok and error, and how the thread heard it (live, or a wake-up).
  result         Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([sessionId])
}

enum RunnerCommandStatus {
  /// Not acknowledged by the runner yet: sent again when it says hello, and each few minutes.
  pending
  /// The runner acknowledged it, or took it without acknowledging (one before OUTBOX_PROTOCOL).
  acked
  /// Not through in 24 hours: a ticket says so.
  failed
  /// Moot by the time it could go (an interrupt, a browser window): dropped.
  expired
}

/// A command for a computer's runner (src/runner-commands.ts): sent at once as before, kept until
/// the runner acknowledges it, and sent again when it reconnects, so neither a restart of the API,
/// a computer that takes long to start, nor a connection that died unnoticed loses it.
model RunnerCommand {
  /// The command's commandId.
  id             String              @id
  organizationId String
  workspaceId    String
  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  computerId     String
  computer       Computer            @relation(fields: [computerId], references: [id], onDelete: Cascade)
  sessionId      String?
  session        Session?            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type           String
  message        Json
  status         RunnerCommandStatus @default(pending)
  /// Times it was sent.
  attempts       Int                 @default(0)
  sentAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

/// A large part of a thread's spec (its connectors, skills, project, design systems), by the
/// SHA-256 of its JSON (src/spec-parts.ts): commands name it rather than carry it, and the runner
/// fetches it once. The same catalog in many commands is one row.
model SpecPart {
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sha256      String
  /// The JSON, as hashed.
  content     String
  createdAt   DateTime  @default(now())
  /// Last named by a spec: parts no spec named for a while are deleted.
  usedAt      DateTime  @default(now())

  @@id([workspaceId, sha256])
  @@index([usedAt])
}

/// One event a trigger took (src/triggers.ts): one row per trigger and event id, claimed before
/// its thread starts, so a vendor's retry, a second reader or a retry after a crash starts no
/// second thread.
model TriggerDelivery {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  triggerId      String
  trigger        Trigger   @relation(fields: [triggerId], references: [id], onDelete: Cascade)
  eventId        String
  /// starting while its thread is being started; then the outcome (started, queued, held, paused,
  /// loop, capped…), or failed when it may be tried again.
  status         String
  threadId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([triggerId, eventId])
}

enum InboundEventStatus {
  pending
  done
  failed
}

/// A vendor's webhook as it came (src/inbound.ts): kept, answered 2xx, then processed from here
/// on the minute's tick with retries, so a restart or a failure loses no event, and a vendor's
/// retry of one is processed once (source and external id).
model InboundEvent {
  id         String             @id @default(cuid())
  /// github, stripe:<subscription id>, hook:<trigger id>.
  source     String
  /// The vendor's id for it (GitHub's delivery, Stripe's event), or a hash of a custom app's body.
  externalId String
  type       String
  payload    Json
  status     InboundEventStatus @default(pending)
  attempts   Int                @default(0)
  /// When it is tried (again).
  nextAt     DateTime           @default(now())
  error      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([source, externalId])
}

/// A thread folder's backup on its cloud computer (the runner's folders.ts): one per thread and
/// teammate, replaced by each newer one, so a lost disk costs minutes of work. Its bytes are in
/// the bucket under the thread's files folder (encrypted by the runner with the workspace's backup
/// key), deleted with the thread, late uploads too (BucketCleanup).
model FolderBackup {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  sessionId      String
  session        Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teammateId     String
  /// The computer that made it.
  computerId     String
  size           BigInt
  /// What the teammate ran in the background then: a list of BackgroundWork.
  background     Json
  takenAt        DateTime @default(now())

  @@unique([sessionId, teammateId])
  @@index([workspaceId])
}

/// A teammate's backup from its cloud computer: kind `tasks` (its crontab and systemd user
/// services) or `browser` (the parts of its Chrome profile that keep its sign-ins). Its bytes are
/// in the bucket, encrypted by the runner with the workspace's backup key.
model TeammateBackup {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  teammateId     String
  teammate       Teammate @relation(fields: [teammateId], references: [id], onDelete: Cascade)
  kind           String
  computerId     String
  size           BigInt
  takenAt        DateTime @default(now())

  @@unique([teammateId, kind])
  @@index([workspaceId])
}

/// An account's login files on its cloud computer (a Claude token, Codex's auth.json), encrypted
/// with the vault's key, kept as they change so a computer that replaces this one is signed in.
model AccountLoginBackup {
  accountId      String   @id
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  organizationId String
  workspaceId    String
  ciphertext     Bytes
  iv             Bytes
  authTag        Bytes
  keyVersion     Int
  /// SHA-256 of the files as the runner read them: an unchanged login is not written again.
  sha256         String
  updatedAt      DateTime @updatedAt

  @@index([workspaceId])
}

/// A cloud computer moved onto a new VM (src/cloud-replace.ts), step by step so an API restart
/// picks it up where it was: backing_up (the old one backs up, then stops), creating (a new VM,
/// its runner installed), restoring (the new runner puts the backups back), done or failed.
/// The old VM stays with the provider, never destroyed by Brigade: its data may still be read.
model ComputerReplacement {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String
  computerId     String
  computer       Computer  @relation(fields: [computerId], references: [id], onDelete: Cascade)
  /// The member who asked for it.
  memberId       String
  phase          String    @default("backing_up")
  /// The VM it replaced, as the provider knows it.
  oldProviderRef Json?
  /// How the old computer's last backup went, if it could make one.
  backup         String?
  /// What did not come back on the new computer: a list of { teammateId?, text }.
  problems       Json?
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  finishedAt     DateTime?

  @@index([computerId, phase])
}
