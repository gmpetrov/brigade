{
  "name": "@brigade/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && node scripts/loops.mjs && tsc -p tsconfig.json",
    "dev": "node scripts/loops.mjs && tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "prisma generate && node scripts/loops.mjs && tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "test": "node scripts/loops.mjs && node --import tsx --test test/*.test.ts",
    "vapid": "node scripts/vapid.mjs",
    "loops": "node scripts/loops.mjs"
  },
  "dependencies": {
    "@blocknote/core": "0.55.0",
    "@blocknote/server-util": "0.55.0",
    "@brigade/contracts": "workspace:*",
    "@brigade/editor": "workspace:^",
    "@brigade/providers": "workspace:*",
    "@hono/node-server": "2.1.4",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.7",
    "fflate": "0.8.3",
    "hono": "4.13.13",
    "linkedom": "0.18.13",
    "mammoth": "1.13.0",
    "parse5": "8.0.1",
    "pg": "8.23.1",
    "prisma": "7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "unpdf": "1.8.1",
    "ws": "8.22.0",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261009.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "wrangler": "4.149.0",
    "yaml": "2.9.1"
  }
}
