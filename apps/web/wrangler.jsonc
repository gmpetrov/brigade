{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The dashboard on Cloudflare Workers, built by OpenNext: scripts/deploy/workers.sh.
  "name": "brigade-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "brigade-web" }],
  "routes": [
    { "pattern": "www.brigade.lol", "custom_domain": true },
    { "pattern": "brigade.lol", "custom_domain": true },
  ],
  "observability": { "enabled": true },
}
