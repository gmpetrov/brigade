{
  "name": "@brigade/desktop",
  "productName": "Brigade",
  "version": "0.0.0",
  "private": true,
  "description": "Brigade.app: installs, links and runs the Brigade runner on a member's computer, and shows the dashboard.",
  "author": {
    "name": "Brigade",
    "email": "support@brigade.lol"
  },
  "homepage": "https://www.brigade.lol",
  "main": "dist/main.js",
  "desktopName": "brigade-desktop.desktop",
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "dev:app": "node scripts/bundle.mjs && node node_modules/electron/install.js && electron .",
    "build:app": "scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "clean": "rm -rf dist release/out .turbo",
    "smoke": "node test/e2e/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "esbuild": "0.28.2",
    "playwright-core": "1.65.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "x11": "4.4.0"
  }
}
