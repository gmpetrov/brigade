{
  "name": "brigade",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cf:build:api": "scripts/deploy/workers.sh build api",
    "cf:deploy:api": "scripts/deploy/workers.sh deploy api",
    "cf:build:api-front": "scripts/deploy/workers.sh build api-front",
    "cf:deploy:api-front": "scripts/deploy/workers.sh deploy api-front",
    "cf:build:web": "scripts/deploy/workers.sh build web",
    "cf:deploy:web": "scripts/deploy/workers.sh deploy web",
    "cf:build:collab": "scripts/deploy/workers.sh build collab",
    "cf:deploy:collab": "scripts/deploy/workers.sh deploy collab"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  }
}
